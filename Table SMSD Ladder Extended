*******************************************************************************************************************************************************************************************
*** Title: SMSD ladder (Table 18 "Schutzeffekt der Erwerbsarbeit gegen SMD") extended by additional controls
*** Table A: pooled 2018-2024 - M1-M12 as before + new controls available in all years (one at a time, then all together)
*** Table B: 2021-2024 only - new controls that exist only from 2021, next to M1/M11/M12 on the SAME sample
*** Each row: OR [95% CI], p, predicted SMSD IWP / NEP, difference in pp (SE) and in % of NEP (SE), N
*** Variables are assigned to A or B automatically from their availability (> 50 % valid in a survey year)
*** PL016, PL020, PL025 are only asked of non-employed persons -> cannot be controls (they would reproduce the group)
*** Input: SILC_All_Years_Adjusted.dta | Output: Ladder_extended_log.txt, sheets T18_A / T18_B in 05_Deprivation_Results.xlsx
*******************************************************************************************************************************************************************************************

capture log close
clear all
set more off
log using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/Ladder_extended_log.txt", text replace

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_All_Years_Adjusted.dta", clear
keep if inrange(year, 2018, 2024)
gen byte s_main = !missing(smd_grp, smd)
egen long hh_cl = group(year idhh)
svyset hh_cl [pw=dwt], vce(linearized)

*** New variables: destring, missing = own category so that N stays constant
foreach v in PH020 PH040 PH060 PY021N PY130N PY120G PW010 PW191 {
    capture confirm variable `v'
    if _rc != 0 {
        di as error "`v' not in the dataset"
        gen double `v' = .
    }
    capture confirm string variable `v'
    if _rc == 0 {
        replace `v' = subinstr(`v', ",", ".", .)
        destring `v', replace force
    }
}
foreach v in PB230 PB240 {
    capture confirm variable `v'
    if _rc != 0 {
        di as error "`v' not in the dataset"
        gen str3 `v' = ""
    }
    capture confirm string variable `v'
    if _rc != 0 {
        tostring `v', replace force
        replace `v' = "" if `v' == "."
    }
    replace `v' = strtrim(`v')
}
gen byte x_chronic = cond(PH020 == 1, 1, cond(PH020 == 2, 0, 9))
gen byte x_unmetmed = cond(PH040 == 1, 1, cond(PH040 == 2, 0, 9))
gen byte x_unmetdent = cond(PH060 == 1, 1, cond(PH060 == 2, 0, 9))
gen byte x_disben = (PY130N > 0 & !missing(PY130N))
gen byte x_sickben = (PY120G > 0 & !missing(PY120G))
gen byte x_compcar = (PY021N > 0 & !missing(PY021N))
gen byte x_migback = 9
replace x_migback = 0 if PB230 == "LOC" & PB240 == "LOC"
replace x_migback = 1 if inlist(PB230, "EU", "OTH") | inlist(PB240, "EU", "OTH")
gen byte x_lifesat = 9
replace x_lifesat = 1 if inrange(PW010, 0, 5)
replace x_lifesat = 2 if inrange(PW010, 6, 7)
replace x_lifesat = 3 if inrange(PW010, 8, 10)
gen byte x_trust = 9
replace x_trust = 1 if inrange(PW191, 0, 4)
replace x_trust = 2 if inrange(PW191, 5, 6)
replace x_trust = 3 if inrange(PW191, 7, 10)

* Availability check: survey years with > 50 % valid values among IWP + NEP
local newvars "chronic unmetmed unmetdent disben sickben compcar migback lifesat trust"
local raw_chronic "PH020"
local raw_unmetmed "PH040"
local raw_unmetdent "PH060"
local raw_disben "PY130N"
local raw_sickben "PY120G"
local raw_compcar "PY021N"
local raw_lifesat "PW010"
local raw_trust "PW191"
local listA ""
local listB ""
foreach x of local newvars {
    capture drop av
    if "`x'" == "migback" gen byte av = (PB230 != "" | PB240 != "")
    else gen byte av = !missing(`raw_`x'')
    local yrs ""
    forvalues y = 2018/2024 {
        quietly summarize av if s_main == 1 & year == `y'
        if r(mean) > 0.5 & r(N) > 0 local yrs "`yrs' `y'"
    }
    local yrs = trim("`yrs'")
    di as text %-10s "`x'" " available in: `yrs'"
    if "`yrs'" == "2018 2019 2020 2021 2022 2023 2024" local listA "`listA' `x'"
    else if "`yrs'" == "2021 2022 2023 2024" local listB "`listB' `x'"
    else di as error "`x': not available in 2018-2024 or 2021-2024 -> not in a table"
}
di as result "Table A (2018-2024): `listA'"
di as result "Table B (2021-2024): `listB'"

*** Controls as in Table 18
local c1 "i.year"
local c2 "i.year i.age_grp"
local c3 "i.year i.sex"
local c4 "i.year i.hh_type"
local c5 "i.year c.inc_rel"
local c6 "i.year i.educ3"
local c7 "i.year i.region"
local c8 "i.year i.urban"
local c9 "i.year i.health_bad"
local c10 "i.year i.limit"
local c11 "i.year i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban i.health_bad i.limit"
local c12 "i.year i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban"
local healthvars "chronic unmetmed unmetdent disben sickben"

*** One row: OR, CI, p, predicted shares, pp and % difference
capture program drop row
program define row
    args tab model label sample controls
    quietly svy, subpop(`sample'): logit smd i.smd_grp `controls'
    local b = _b[1.smd_grp]
    local se = _se[1.smd_grp]
    local crit = invttail(e(df_r), 0.025)
    local p = 2 * ttail(e(df_r), abs(`b' / `se'))
    local n = e(N_sub)
    quietly margins smd_grp, subpop(`sample') vce(unconditional) post
    local s1 = 100 * _b[1.smd_grp]
    local s0 = 100 * _b[0bn.smd_grp]
    quietly nlcom (pp: 100 * (_b[1.smd_grp] - _b[0bn.smd_grp])) (rel: 100 * (_b[1.smd_grp] / _b[0bn.smd_grp] - 1)), post
    post res ("`tab'") ("`model'") ("`label'") (exp(`b')) (exp(`b' - `crit' * `se')) (exp(`b' + `crit' * `se')) (`p') (`s1') (`s0') (_b[pp]) (_se[pp]) (_b[rel]) (_se[rel]) (`n')
    di as text %-5s "`model'" %-32s " `label'" " OR " %5.3f exp(`b') "  p=" %6.4f `p' "  IWP " %5.2f `s1' "  NEP " %5.2f `s0' "  " %6.2f _b[pp] " pp (" %4.2f _se[pp] ")  " %6.1f _b[rel] " % (" %4.1f _se[rel] ")  N=" `n'
end

tempfile results
postfile res str2 tab str6 model str40 label double(or or_lo or_hi p s_iwp s_nep pp pp_se rel rel_se n) using `results', replace

local lab1 "nur Jahr"
local lab2 "Alter"
local lab3 "Geschlecht"
local lab4 "Haushaltstyp"
local lab5 "Einkommensposition"
local lab6 "Bildung"
local lab7 "Region"
local lab8 "Urbanisierungsgrad"
local lab9 "Gesundheitszustand"
local lab10 "Einschränkung im Alltag"
local lab11 "alle Kontrollen zusammen"
local lab12 "alle Kontrollen ohne Gesundheit"
local lab_chronic "Chronische Krankheit"
local lab_unmetmed "Unerfüllter Behandlungsbedarf"
local lab_unmetdent "Unerfüllter Zahnbehandlungsbedarf"
local lab_disben "Invaliditätsleistungen"
local lab_sickben "Krankengeld"
local lab_compcar "Firmenwagen"
local lab_migback "Migrationshintergrund (Eltern)"
local lab_lifesat "Lebenszufriedenheit"
local lab_trust "Vertrauen in andere"

foreach t in A B {
    if "`t'" == "A" {
        local lst "`listA'"
        capture drop s_t
        gen byte s_t = s_main
        di _n(2) as result "=================== Table A: pooled 2018-2024 ==================="
    }
    else {
        local lst "`listB'"
        if "`lst'" == "" continue
        capture drop s_t
        gen byte s_t = s_main & inrange(year, 2021, 2024)
        di _n(2) as result "=================== Table B: 2021-2024 ==================="
    }
    * Table 18 rows (in Table B on the 2021-2024 sample as reference)
    forvalues m = 1/12 {
        if "`t'" == "B" & !inlist(`m', 1, 11, 12) continue
        row `t' "M`m'" "`lab`m''" s_t "`c`m''"
    }
    * New controls one at a time (year + X), then added to M11 and M12
    local k = 12
    local addall ""
    local addnohealth ""
    foreach x of local lst {
        local k = `k' + 1
        row `t' "M`k'" "`lab_`x''" s_t "i.year i.x_`x'"
        local addall "`addall' i.x_`x'"
        local ish : list x in healthvars
        if `ish' == 0 local addnohealth "`addnohealth' i.x_`x'"
    }
    if "`lst'" != "" {
        row `t' "M11+" "alle Kontrollen + neue Variablen" s_t "`c11' `addall'"
        row `t' "M12+" "ohne Gesundheit + neue (ohne Gesundheit)" s_t "`c12' `addnohealth'"
    }
}
postclose res

use `results', clear
format or or_lo or_hi %5.3f
format p %6.4f
format s_iwp s_nep pp pp_se %6.2f
format rel rel_se %6.1f
list tab model label or or_lo or_hi p s_iwp s_nep pp pp_se rel rel_se n, noobs abbreviate(8) sepby(tab) linesize(200)
preserve
keep if tab == "A"
export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/05_Deprivation_Results.xlsx", sheet("T18_A", replace) firstrow(variables)
restore
keep if tab == "B"
if _N > 0 export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/05_Deprivation_Results.xlsx", sheet("T18_B", replace) firstrow(variables)

di as result "=== FERTIG ==="
log close
