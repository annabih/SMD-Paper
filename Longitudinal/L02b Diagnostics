*******************************************************************************************************************************************************************************************
*** Title: Diagnostics for the longitudinal file - coverage and coding of deprivation items, SMSD and controls by year and release
*** Why: L03 showed implausible year effects (SMSD close to 1 in the base year) and few valid SMSD person-years
***      -> check whether items are missing or coded differently in some years / releases
*** Input: SILC_Long_Prepared.dta (L02)
*** Output: L02b_Diagnostics_log.txt
*******************************************************************************************************************************************************************************************

capture log close
clear all
set more off

log using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/L02b_Diagnostics_log.txt", text replace

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear
keep if inrange(dag, 18, 64)

*** Observations by year and release
tab year release

*** Raw codes of the 13 items by year (18-64)
foreach v in HS060 HS040 HS050 HH050 HS110 HD080 HS011 HS021 HS031 PD020 PD030 PD050 PD060 PD070 PD080 {
    di _n as result "=== `v' by year ==="
    tab year `v', missing
}

*** Same for one household and one personal item by release (does coding differ between releases?)
foreach v in HS040 PD020 HD080 {
    di _n as result "=== `v' by release ==="
    tab release `v', missing
}

*** Rebuilt items, number lacking, valid items, SMSD by year
tab year smsd_valid, missing
tab year smsd_n, missing
tab year smd, missing
table year, statistic(mean dep_unexpected dep_holiday dep_meal dep_warm dep_car dep_furniture dep_arrears dep_clothes dep_shoes dep_social dep_leisure dep_pocket dep_internet) nformat(%9.3f mean)

*** Same within the SMD comparison groups
tab year smd if !missing(smd_grp), missing

*** Controls: coverage by year
tab year educ3, missing
tab year health_bad, missing
tab year limit, missing
tab year region, missing
tab year urban, missing
tab year act_status, missing
foreach v in PL031 PL032 PE040 PE041 PH010 PH030 DB100 {
    di _n as result "=== `v': non-missing by year ==="
    tab year if !missing(`v')
}

log close
