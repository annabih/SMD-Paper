*******************************************************************************************************************************************************************************************
*** Title: HH incomes, poverty thresholds, poverty labels (MA-II logic on EU-SILC)
*** Replaces: "HH Incomes, Poverty Thresholds, Poverty label"
*** Aim: Equivalised pre/post-transfer income, relative threshold, in-work poverty, AROP w/o IWP, gaps, euro bands, SMD groups
*** Changes vs. MA-II:
***   - Income from UDB household variables instead of EUROMOD income lists
***     post = HY020 / HX050, pre = HY022 / HX050 (before social transfers other than old-age and survivor benefits)
***   - UDB incomes are annual -> divided by 12 so that all amounts are monthly (as in EUROMOD output)
***   - No anchored threshold and no threshold effects (no policy scenario on EU-SILC)
***   - AROP w/o IWP = poor and not working >= 7 months in any status (any_worker == 0), all ages
***   - SMD groups: both 18-64, old-age benefit recipients excluded
*******************************************************************************************************************************************************************************************
clear all
set more off


use "Y:/Desktop/USB/SMSD_Paper/SILC_All_Years_Prepared.dta", clear

********************************************************************************
* Equivalised household income (monthly)
* HY020 / HY022 are household totals and must be equivalised with HX050
* Both bounded at 0 (negative incomes -> 0), so gaps in % are comparable pre/post
* max() returns 0 for missing arguments -> guarded by if conditions
********************************************************************************

gen double post_disp_hh_income_equ = max((HY020 / HX050) / 12, 0) if !missing(HY020, HX050) & HX050 > 0
gen double pre_disp_hh_income_equ = max((HY022 / HX050) / 12, 0) if !missing(HY022, HX050) & HX050 > 0

label variable post_disp_hh_income_equ "Post-transfer disposable household income, equalised, monthly (HY020/HX050)"
label variable pre_disp_hh_income_equ "Pre-transfer disposable household income, equalised, monthly, pensions included (HY022/HX050)"

* Check against official equivalised disposable income HX090
gen double check_hx090 = post_disp_hh_income_equ - HX090 / 12
di _n "=== Check: HY020/HX050 minus HX090 (monthly) ===" _n
sum check_hx090, detail
drop check_hx090

********************************************************************************
* Relative poverty threshold: 60% of weighted median, by year
********************************************************************************

gen double poverty_threshold_rel = .

levelsof year, local(years)

foreach y of local years {
    quietly _pctile post_disp_hh_income_equ [aw=dwt] if year == `y' & dwt > 0 & !missing(post_disp_hh_income_equ, dwt), p(50)
    replace poverty_threshold_rel = r(r1) * 0.6 if year == `y'
}

label variable poverty_threshold_rel "Relative poverty threshold: 60% median by year, monthly"

di _n "=== Monthly poverty thresholds ===" _n
table year, statistic(mean poverty_threshold_rel) nototals nformat(%12.2fc mean)

********************************************************************************
* In-work poverty indicators (employed = employee >= 7 months, age 18-64)
********************************************************************************

gen byte iw_arop_pre_rel = pre_disp_hh_income_equ < poverty_threshold_rel if employed == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen byte iw_poor_post_rel = post_disp_hh_income_equ < poverty_threshold_rel if employed == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

label variable iw_arop_pre_rel "Below relative poverty threshold, pre-transfer income"
label variable iw_poor_post_rel "Below relative poverty threshold, post-transfer income"

gen byte diff_rel = iw_arop_pre_rel - iw_poor_post_rel if employed == 1
label variable diff_rel "Difference pre - post, relative threshold"

* Sanity check: post >= pre for (almost) everyone, so diff_rel should not be negative
tab diff_rel if employed == 1, missing

********************************************************************************
* AROP indicators, total population
********************************************************************************

gen byte arop_pre_rel = pre_disp_hh_income_equ < poverty_threshold_rel if !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen byte arop_post_rel = post_disp_hh_income_equ < poverty_threshold_rel if !missing(post_disp_hh_income_equ, poverty_threshold_rel)

label variable arop_pre_rel "AROP total pop, pre-transfer, relative threshold"
label variable arop_post_rel "AROP total pop, post-transfer, relative threshold"

gen byte arop_diff_rel = arop_pre_rel - arop_post_rel
label variable arop_diff_rel "AROP diff pre - post, relative threshold"

* Check own AROP flag against official poverty indicator HX080
di _n "=== Check: own AROP post vs. HX080 ===" _n
tab arop_post_rel HX080 if !missing(HX080), missing

********************************************************************************
* AROP without IWP = not working >= 7 months in any status, below threshold
* All ages (general descriptives); restricted to 18-64 only for the SMD comparison
* Poor self-employed workers are in neither group
********************************************************************************

gen byte axi_pre_rel = pre_disp_hh_income_equ < poverty_threshold_rel if any_worker == 0 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen byte axi_post_rel = post_disp_hh_income_equ < poverty_threshold_rel if any_worker == 0 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

label variable axi_pre_rel "AROP w/o IWP (not working, all ages), pre-transfer, relative threshold"
label variable axi_post_rel "AROP w/o IWP (not working, all ages), post-transfer, relative threshold"

gen byte axi_diff_rel = axi_pre_rel - axi_post_rel
label variable axi_diff_rel "AROP w/o IWP diff pre - post, relative threshold"

********************************************************************************
* 1. Gap only among poor persons (monthly EUR, positive = below threshold)
********************************************************************************

gen double gap_pre_rel = poverty_threshold_rel - pre_disp_hh_income_equ if employed == 1 & iw_arop_pre_rel == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen double gap_post_rel = poverty_threshold_rel - post_disp_hh_income_equ if employed == 1 & iw_poor_post_rel == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

gen double gap_axi_pre_rel = poverty_threshold_rel - pre_disp_hh_income_equ if axi_pre_rel == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen double gap_axi_post_rel = poverty_threshold_rel - post_disp_hh_income_equ if axi_post_rel == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

********************************************************************************
* 2. Gap over all employed persons (non-poor employed = 0)
********************************************************************************

gen double gap_pre_rel_all = max(poverty_threshold_rel - pre_disp_hh_income_equ, 0) if employed == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen double gap_post_rel_all = max(poverty_threshold_rel - post_disp_hh_income_equ, 0) if employed == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

********************************************************************************
* 3. Poverty gap as percentage of threshold
********************************************************************************

gen double gap_pre_rel_pct = 100 * gap_pre_rel / poverty_threshold_rel
gen double gap_post_rel_pct = 100 * gap_post_rel / poverty_threshold_rel

gen double gap_pre_rel_all_pct = 100 * gap_pre_rel_all / poverty_threshold_rel
gen double gap_post_rel_all_pct = 100 * gap_post_rel_all / poverty_threshold_rel

gen double gap_axi_pre_rel_pct = 100 * gap_axi_pre_rel / poverty_threshold_rel
gen double gap_axi_post_rel_pct = 100 * gap_axi_post_rel / poverty_threshold_rel

********************************************************************************
* Labels
********************************************************************************

label variable gap_pre_rel "Poverty gap among poor employed, pre-transfer, relative threshold"
label variable gap_post_rel "Poverty gap among poor employed, post-transfer, relative threshold"
label variable gap_axi_pre_rel "Poverty gap among AROP w/o IWP, pre-transfer, relative threshold"
label variable gap_axi_post_rel "Poverty gap among AROP w/o IWP, post-transfer, relative threshold"

label variable gap_pre_rel_all "Poverty gap all employed, pre-transfer, relative threshold"
label variable gap_post_rel_all "Poverty gap all employed, post-transfer, relative threshold"

label variable gap_pre_rel_pct "Poverty gap among poor employed in %, pre-transfer"
label variable gap_post_rel_pct "Poverty gap among poor employed in %, post-transfer"
label variable gap_pre_rel_all_pct "Poverty gap all employed in %, pre-transfer"
label variable gap_post_rel_all_pct "Poverty gap all employed in %, post-transfer"
label variable gap_axi_pre_rel_pct "Poverty gap among AROP w/o IWP in %, pre-transfer"
label variable gap_axi_post_rel_pct "Poverty gap among AROP w/o IWP in %, post-transfer"

********************************************************************************
* Real values: HICP Austria (annual average, 2015 = 100, Eurostat prc_hicp_aind)
* Deflated by the income reference year (= UDB year - 1), in prices of 2023
* (= income reference year of UDB 2024)
********************************************************************************

gen double hicp_inc = .
replace hicp_inc = 100.97 if year == 2017
replace hicp_inc = 103.22 if year == 2018
replace hicp_inc = 105.41 if year == 2019
replace hicp_inc = 106.98 if year == 2020
replace hicp_inc = 108.47 if year == 2021
replace hicp_inc = 111.46 if year == 2022
replace hicp_inc = 121.07 if year == 2023
replace hicp_inc = 130.40 if year == 2024
label variable hicp_inc "HICP Austria of income reference year (2015 = 100)"

gen double defl = 130.40 / hicp_inc
label variable defl "Deflator to prices of 2023"

* Real values only for the distance to the threshold (gaps and euro bands)
foreach g in pre_rel post_rel axi_pre_rel axi_post_rel {
    gen double gap_`g'_real = gap_`g' * defl
    label variable gap_`g'_real "Poverty gap `g', monthly, real (prices 2023)"
}

********************************************************************************
* Euro bands below the threshold (monthly EUR), nominal and real (prices 2023)
* Bands: (0,100], (100,250], (250,500], (500,750], (750,1000], >1000
* Suffix "" = nominal, "_real" = real
********************************************************************************

label define bandlbl 1 "(0,100]" 2 "(100,250]" 3 "(250,500]" 4 "(500,750]" 5 "(750,1000]" 6 ">1000"

foreach g in pre_rel post_rel axi_pre_rel axi_post_rel {
    foreach r in "" "_real" {
        gen byte band_`g'`r' = .
        replace band_`g'`r' = 1 if gap_`g'`r' > 0 & gap_`g'`r' <= 100 & !missing(gap_`g'`r')
        replace band_`g'`r' = 2 if gap_`g'`r' > 100 & gap_`g'`r' <= 250 & !missing(gap_`g'`r')
        replace band_`g'`r' = 3 if gap_`g'`r' > 250 & gap_`g'`r' <= 500 & !missing(gap_`g'`r')
        replace band_`g'`r' = 4 if gap_`g'`r' > 500 & gap_`g'`r' <= 750 & !missing(gap_`g'`r')
        replace band_`g'`r' = 5 if gap_`g'`r' > 750 & gap_`g'`r' <= 1000 & !missing(gap_`g'`r')
        replace band_`g'`r' = 6 if gap_`g'`r' > 1000 & !missing(gap_`g'`r')
        label values band_`g'`r' bandlbl
        label variable band_`g'`r' "Euro distance below threshold, `g'`r'"
        forvalues k = 1/6 {
            gen byte pct_b`k'_`g'`r' = 100 * (band_`g'`r' == `k') if !missing(band_`g'`r')
        }
    }
}

********************************************************************************
* SMD comparison groups (post-transfer)
* Both 18-64, old-age benefit recipients (PY100G > 0) excluded
* 1 = IWP Employees, 0 = AROP w/o IWP
********************************************************************************

gen byte smd_grp = .
replace smd_grp = 1 if employed == 1 & iw_poor_post_rel == 1 & oldage_ben == 0
replace smd_grp = 0 if axi_post_rel == 1 & inrange(dag, 18, 64) & oldage_ben == 0

label define smdgrp 0 "AROP w/o IWP (18-64, no old-age pension)" 1 "IWP Employees (18-64, no old-age pension)"
label values smd_grp smdgrp
label variable smd_grp "SMD comparison group, post-transfer"

tab year smd_grp, missing

********************************************************************************
* Controls for the "beyond income" models (script 04, PART 4)
********************************************************************************

* Income position: equivalised post-transfer income in % of poverty threshold
* Both SMD groups are below the threshold, so inc_rel lies in [0, 100)
gen double inc_rel = 100 * post_disp_hh_income_equ / poverty_threshold_rel if !missing(post_disp_hh_income_equ, poverty_threshold_rel)
label variable inc_rel "Equivalised post-transfer income in % of poverty threshold"

* Household composition, counted within year and household
* Children < 14 / adults 14+ (as in the earlier IWP-SMD scripts and the modified OECD scale)
bysort year idhh: egen n_children = total(dag < 14 & !missing(dag))
bysort year idhh: egen n_adults = total(dag >= 14 & !missing(dag))
label variable n_children "Number of children (< 14) in household"
label variable n_adults "Number of persons 14+ in household"

* Household type (as in the earlier IWP-SMD scripts)
gen byte hh_type = .
replace hh_type = 1 if n_adults == 1 & n_children == 0
replace hh_type = 2 if n_adults == 1 & n_children == 1
replace hh_type = 3 if n_adults == 1 & n_children >= 2
replace hh_type = 4 if n_adults == 2 & n_children == 0
replace hh_type = 5 if n_adults == 2 & n_children == 1
replace hh_type = 6 if n_adults == 2 & n_children == 2
replace hh_type = 7 if n_adults == 2 & n_children >= 3
replace hh_type = 8 if n_adults >= 3 & n_children == 0
replace hh_type = 9 if n_adults >= 3 & n_children >= 1
label define hhtypelbl 1 "1 adult" 2 "1 adult + 1 child" 3 "1 adult + 2+ children" 4 "2 adults" 5 "2 adults + 1 child" 6 "2 adults + 2 children" 7 "2 adults + 3+ children" 8 "3+ adults" 9 "3+ adults + children"
label values hh_type hhtypelbl
label variable hh_type "Household type"

* Children categories
gen byte has_kids = (n_children > 0)
gen byte n_ch_cat = min(n_children, 3)
label define nchcat 0 "0" 1 "1" 2 "2" 3 "3+"
label values n_ch_cat nchcat
label variable has_kids "Household with children (< 14)"
label variable n_ch_cat "Number of children (< 14), 0/1/2/3+"

* Age groups (SMD groups are 18-64)
gen byte age_grp = .
replace age_grp = 1 if inrange(dag, 18, 29)
replace age_grp = 2 if inrange(dag, 30, 44)
replace age_grp = 3 if inrange(dag, 45, 54)
replace age_grp = 4 if inrange(dag, 55, 64)
label define agegrp 1 "18-29" 2 "30-44" 3 "45-54" 4 "55-64"
label values age_grp agegrp
label variable age_grp "Age group (18-64)"

* Mean income position by group: are IWP Employees closer to the threshold?
table year smd_grp [pw=dwt], statistic(mean inc_rel) nototals nformat(%9.2f mean)

save "Y:/Desktop/USB/SMSD_Paper/SILC_All_Years_Adjusted.dta", replace
