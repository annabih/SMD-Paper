*******************************************************************************************************************************************************************************************
*** PART E: Item decomposition - employment effect on each item (M1-M12, one table per model)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART E: Item decomposition ==================="

forvalues m = 1/12 {
    di _n as result "--- Items, M`m': `c`m'' ---"
    foreach y in `items13' `items_arr' {
        grp_effect `y', sample(s_main) group(smd_grp) controls(`c`m'')
        post `ph' ("E_items") ("`y'") ("M`m'") (r(n)) (r(or)) (r(or_lo)) (r(or_hi)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    }
}

postclose `ph'


*******************************************************************************************************************************************************************************************
*** PART F: Heterogeneity - does the employment effect differ by household type / children?
*** Interaction models on M4 controls; joint Wald test of the interaction terms
***   F1: smd_grp x hh_type (9 household types)
***   F2: smd_grp x has_kids (0 vs. 1+ children; robust to small cells)
***   F3: smd_grp x n_ch_cat (0/1/2/3+ children)
*** p-values Holm- and Bonferroni-adjusted across the 13 items (index tested separately)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART F: Heterogeneity ==================="

tempname pg
tempfile res_het
postfile `pg' str16 outcome double(p_hhtype p_haskids p_nchcat) using `res_het', replace

foreach y in smd `items13' {

    di _n as result "--- `y' ---"

    quietly svy, subpop(s_main): logit `y' i.smd_grp##i.hh_type i.year i.age_grp i.sex c.inc_rel
    quietly testparm i.smd_grp#i.hh_type
    local p1 = r(p)

    quietly svy, subpop(s_main): logit `y' i.smd_grp##i.has_kids c.n_adults i.year i.age_grp i.sex c.inc_rel
    quietly testparm i.smd_grp#i.has_kids
    local p2 = r(p)

    quietly svy, subpop(s_main): logit `y' i.smd_grp##i.n_ch_cat c.n_adults i.year i.age_grp i.sex c.inc_rel
    quietly testparm i.smd_grp#i.n_ch_cat
    local p3 = r(p)

    di as text %-16s "`y'" " p(group x hh_type) = " %6.4f `p1' "   p(group x has_kids) = " %6.4f `p2' "   p(group x n_children) = " %6.4f `p3'
    post `pg' ("`y'") (`p1') (`p2') (`p3')

    * Effect of employment by subgroup (x100 = pp, with 95% CI)
    * Shown for the index (to quantify a null result: how large a difference can the CIs exclude?),
    * for the food item (SA2 finding) and for every item with unadjusted p < 0.05 in the respective test
    if "`y'" == "smd" | "`y'" == "dep_meal" | `p1' < 0.05 {
        quietly svy, subpop(s_main): logit `y' i.smd_grp##i.hh_type i.year i.age_grp i.sex c.inc_rel
        di _n as text "Employment effect by household type (dydx x100 = pp):"
        margins hh_type, dydx(smd_grp) subpop(s_main) vce(unconditional)
        di _n as text "Odds ratios by household type:"
        forvalues h = 1/9 {
            capture lincom _b[1.smd_grp] + _b[1.smd_grp#`h'.hh_type], or
        }
    }
    if "`y'" == "smd" | "`y'" == "dep_meal" | `p2' < 0.05 {
        quietly svy, subpop(s_main): logit `y' i.smd_grp##i.has_kids c.n_adults i.year i.age_grp i.sex c.inc_rel
        di _n as text "Employment effect without / with children (dydx x100 = pp):"
        margins has_kids, dydx(smd_grp) subpop(s_main) vce(unconditional)
    }
    if "`y'" == "smd" | "`y'" == "dep_meal" | `p3' < 0.05 {
        quietly svy, subpop(s_main): logit `y' i.smd_grp##i.n_ch_cat c.n_adults i.year i.age_grp i.sex c.inc_rel
        di _n as text "Employment effect by number of children (dydx x100 = pp):"
        margins n_ch_cat, dydx(smd_grp) subpop(s_main) vce(unconditional)
    }
}
postclose `pg'

*** Cell sizes household type x group (check before interpreting)
tab hh_type smd_grp if s_main == 1


*******************************************************************************************************************************************************************************************
*** PART G: Household structure and poverty risk - children vs. adults
*** Outcomes: poverty pre and post within each group's base population (2018-2024, age 18-64)
***   IWP Employees: base = employees >= 7 months (employed == 1); outcome iw_arop_pre_rel / iw_poor_post_rel
***   AROP w/o IWP: base = not working >= 7 months in any status, 18-64, without old-age benefits; outcome axi_pre_rel / axi_post_rel
*** Models: M1 children, M2 adults, M3 both, M4 both standardised; all with year FE
*** Wald test children = adults in M3 and M4 (needed before claiming that one predictor dominates)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART G: Children vs. adults ==================="

capture drop base_iwp base_axi z_children z_adults
gen byte base_iwp = (employed == 1 & inrange(year, 2018, 2024))
gen byte base_axi = (any_worker == 0 & inrange(dag, 18, 64) & oldage_ben == 0 & inrange(year, 2018, 2024))

egen z_children = std(n_children) if inrange(dag, 18, 64) & inrange(year, 2018, 2024)
egen z_adults = std(n_adults) if inrange(dag, 18, 64) & inrange(year, 2018, 2024)
label variable z_children "Number of children (standardised, 18-64, 2018-2024)"
label variable z_adults "Number of persons 14+ (standardised, 18-64, 2018-2024)"

tempname phh
tempfile res_hh
postfile `phh' str16 outcome str4 model str12 predictor double(n or or_lo or_hi p) using `res_hh', replace

foreach y in iw_arop_pre_rel iw_poor_post_rel axi_pre_rel axi_post_rel {

    if inlist("`y'", "iw_arop_pre_rel", "iw_poor_post_rel") local base "base_iwp"
    else local base "base_axi"

    di _n as result "--- `y' (base: `base') ---"

    local p1 "c.n_children"
    local p2 "c.n_adults"
    local p3 "c.n_children c.n_adults"
    local p4 "c.z_children c.z_adults"

    forvalues m = 1/4 {
        svy, subpop(`base'): logit `y' `p`m'' i.year, or
        local df = e(df_r)
        local n = e(N_sub)
        local crit = invttail(`df', 0.025)
        foreach x in n_children n_adults z_children z_adults {
            capture local b = _b[`x']
            if _rc == 0 {
                local se = _se[`x']
                post `phh' ("`y'") ("M`m'") ("`x'") (`n') (exp(`b')) (exp(`b' - `crit' * `se')) (exp(`b' + `crit' * `se')) (2 * ttail(`df', abs(`b' / `se')))
            }
        }
        * Test: is the children effect equal to the adults effect? (M3 per person, M4 per SD)
        if `m' == 3 {
            test n_children = n_adults
            post `phh' ("`y'") ("M3") ("test ch=ad") (`n') (.) (.) (.) (r(p))
        }
        if `m' == 4 {
            test z_children = z_adults
            post `phh' ("`y'") ("M4") ("test ch=ad") (`n') (.) (.) (.) (r(p))
        }
        * AMEs (x100 = pp) for the joint unstandardised model
        if `m' == 3 {
            margins, dydx(n_children n_adults) subpop(`base') vce(unconditional)
        }
    }
}
postclose `phh'


*******************************************************************************************************************************************************************************************
*** PART G2: Household structure and SMD - children vs. adults within the SMD comparison groups
*** Sample: s_main (IWP Employees and AROP w/o IWP, 18-64, post-transfer, without old-age benefit recipients), 2018-2024
*** Outcome: smd (SMSD, 13 items rebuilt); no pre/post (SMD has no pre-transfer version)
*** Variants: a = year FE only (total effect of household composition)
***           b = year FE + income position (inc_rel): do children raise SMD beyond their effect on equivalised income?
*** Models per group: M1 children, M2 persons 14+, M3 both, M4 both standardised (as in Part G); Wald test children = adults
*** Effects of +1 child / +1 person 14+ from M3: predicted SMD share before and after +1, pp and % change with SE
*** Pooled interaction model: does the children (adults) effect differ between IWP Employees and AROP w/o IWP?
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART G2: Children vs. adults and SMD ==================="

capture drop g2_iwp g2_axi
gen byte g2_iwp = (s_main == 1 & smd_grp == 1)
gen byte g2_axi = (s_main == 1 & smd_grp == 0)

local g2_ctrl_a "i.year"
local g2_ctrl_b "i.year c.inc_rel"

tempname pg2 pg2e
tempfile res_g2 res_g2e
postfile `pg2' str4 group str2 variant str4 model str16 predictor double(n or or_lo or_hi p) using `res_g2', replace
postfile `pg2e' str4 group str2 variant str12 predictor double(n s0 s1 pp pp_se rel rel_se p) using `res_g2e', replace

foreach v in a b {
    foreach g in iwp axi {
        di _n as result "--- SMD, group `g', variant `v' (`g2_ctrl_`v'') ---"

        local p1 "c.n_children"
        local p2 "c.n_adults"
        local p3 "c.n_children c.n_adults"
        local p4 "c.z_children c.z_adults"

        forvalues m = 1/4 {
            svy, subpop(g2_`g'): logit smd `p`m'' `g2_ctrl_`v'', or
            local df = e(df_r)
            local n = e(N_sub)
            local crit = invttail(`df', 0.025)
            foreach x in n_children n_adults z_children z_adults {
                capture local b = _b[`x']
                if _rc == 0 {
                    local se = _se[`x']
                    post `pg2' ("`g'") ("`v'") ("M`m'") ("`x'") (`n') (exp(`b')) (exp(`b' - `crit' * `se')) (exp(`b' + `crit' * `se')) (2 * ttail(`df', abs(`b' / `se')))
                }
            }
            if `m' == 3 {
                test n_children = n_adults
                post `pg2' ("`g'") ("`v'") ("M3") ("test ch=ad") (`n') (.) (.) (.) (r(p))
            }
            if `m' == 4 {
                test z_children = z_adults
                post `pg2' ("`g'") ("`v'") ("M4") ("test ch=ad") (`n') (.) (.) (.) (r(p))
            }
            * +1 child / +1 person 14+ from M3: predicted shares, pp and % change
            if `m' == 3 {
                estimates store g2_m3
                foreach x in n_children n_adults {
                    estimates restore g2_m3
                    quietly margins, at(`x' = generate(`x')) at(`x' = generate(`x' + 1)) subpop(g2_`g') vce(unconditional) post
                    local s0 = _b[1._at] * 100
                    local s1 = _b[2._at] * 100
                    quietly lincom (_b[2._at] - _b[1._at]) * 100
                    local pp = r(estimate)
                    local pp_se = r(se)
                    local pval = r(p)
                    quietly nlcom (_b[2._at] / _b[1._at] - 1) * 100
                    local rel = el(r(b), 1, 1)
                    local rel_se = sqrt(el(r(V), 1, 1))
                    di as text "`g' `v' +1 `x': " %5.2f `s0' "% -> " %5.2f `s1' "% | " %6.2f `pp' " pp (SE " %4.2f `pp_se' ") | " %6.1f `rel' " % (SE " %4.1f `rel_se' ") | p=" %6.4f `pval'
                    post `pg2e' ("`g'") ("`v'") ("`x'") (`n') (`s0') (`s1') (`pp') (`pp_se') (`rel') (`rel_se') (`pval')
                }
                estimates drop g2_m3
            }
        }
    }

    * Pooled model with interactions: does the effect of children / adults on SMD differ between the groups?
    di _n as result "--- SMD, pooled interaction model, variant `v' ---"
    svy, subpop(s_main): logit smd i.smd_grp##(c.n_children c.n_adults) `g2_ctrl_`v'', or
    local n = e(N_sub)
    test 1.smd_grp#c.n_children
    post `pg2' ("pool") ("`v'") ("M3") ("test grp x ch") (`n') (.) (.) (.) (r(p))
    test 1.smd_grp#c.n_adults
    post `pg2' ("pool") ("`v'") ("M3") ("test grp x ad") (`n') (.) (.) (.) (r(p))
    test 1.smd_grp#c.n_children 1.smd_grp#c.n_adults
    post `pg2' ("pool") ("`v'") ("M3") ("test grp x both") (`n') (.) (.) (.) (r(p))
}
postclose `pg2'
postclose `pg2e'


