*** One row: model with controls, plus M1 on the same sample
capture program drop row
program define row
    args model label sample controls years
    quietly svy, subpop(`sample'): logit smd i.smd_grp i.year
    quietly margins smd_grp, subpop(`sample') vce(unconditional) post
    quietly nlcom (pp: 100 * (_b[1.smd_grp] - _b[0bn.smd_grp])) (rel: 100 * (_b[1.smd_grp] / _b[0bn.smd_grp] - 1)), post
    local pp1 = _b[pp]
    local rel1 = _b[rel]
    quietly svy, subpop(`sample'): logit smd i.smd_grp i.year `controls'
    local b = _b[1.smd_grp]
    local se = _se[1.smd_grp]
    local crit = invttail(e(df_r), 0.025)
    local p = 2 * ttail(e(df_r), abs(`b' / `se'))
    local n = e(N_sub)
    quietly margins smd_grp, subpop(`sample') vce(unconditional) post
    local s1 = 100 * _b[1.smd_grp]
    local s0 = 100 * _b[0bn.smd_grp]
    quietly nlcom (pp: 100 * (_b[1.smd_grp] - _b[0bn.smd_grp])) (rel: 100 * (_b[1.smd_grp] / _b[0bn.smd_grp] - 1)), post
    post res ("`model'") ("`label'") ("`years'") (exp(`b')) (exp(`b' - `crit' * `se')) (exp(`b' + `crit' * `se')) (`p') (`s1') (`s0') (_b[pp]) (_se[pp]) (_b[rel]) (_se[rel]) (`pp1') (`rel1') (`n')
    di as text %-6s "`model'" %-42s " `label'" " OR " %5.3f exp(`b') " p=" %6.4f `p' " IWP " %5.2f `s1' " NEP " %5.2f `s0' " " %6.2f _b[pp] " pp (" %4.2f _se[pp] ") " %6.1f _b[rel] " % (" %4.1f _se[rel] ") | M1 same sample " %6.2f `pp1' " pp " %6.1f `rel1' " % | N=" `n' " | `years'"
end

tempfile results
postfile res str6 model str45 label str40 years double(or or_lo or_hi p s_iwp s_nep pp pp_se rel rel_se pp_M1 rel_M1 n) using `results', replace

* M1-M10: all years
forvalues m = 1/10 {
    row "M`m'" "`l`m''" s_main "`c`m''" "2018-2024"
}
* M11 ff.: new variables, in the years in which all variables of the model exist
forvalues m = 11/`last' {
    local yrs "2018 2019 2020 2021 2022 2023 2024"
    local ctrl ""
    foreach v of local v`m' {
        local yrs : list yrs & yrs_`v'
        local ctrl "`ctrl' i.x_`v'"
    }
    if "`yrs'" == "" {
        di as error "M`m' `l`m'': no survey year with all variables - skipped"
        continue
    }
    local yrsc = subinstr(trim("`yrs'"), " ", ",", .)
    capture drop s_m
    gen byte s_m = (s_main == 1 & inlist(year, `yrsc'))
    capture noisily row "M`m'" "`l`m''" s_m "`ctrl'" "`yrs'"
}
* All controls together / without health (former M11 / M12), all years
row "Alle" "alle Kontrollen zusammen" s_main "i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban i.health_bad i.limit" "2018-2024"
row "OhneG" "alle Kontrollen ohne Gesundheit" s_main "i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban" "2018-2024"
postclose res

