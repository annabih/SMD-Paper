*******************************************************************************************************************************************************************************************
*** Title: SMSD ladder (Table 18 "Schutzeffekt der Erwerbsarbeit gegen SMD") - each additional variable as its own single-control model
*** M1-M10 as before (year + one control); M11 ff.: year + one new variable (or a group of related variables jointly)
*** At the end: all controls together and all controls without health (= former M11 / M12)
*** Each new variable is used in the survey years in which it exists (> 50 % valid); the columns pp_M1 / rel_M1 give M1
*** (year only) on exactly the same sample, so the change through the control can be read directly
*** Coding: categorical, missing = own category 99 (N constant within the available years); amounts (PY...) as "> 0"
***   PL016, PL020, PL025 are only asked of non-employed persons: IWP are set to "experience other than occasional work" (PL016 = 3)
***   and to "no" (PL020 / PL025 = 2); the variables then separate the NEP among themselves
***   PH030 (limitation) is already M10 and therefore not repeated
*** Input: SILC_All_Years_Adjusted.dta | Output: Ladder_extended_log.txt, sheet T18_ext in 05_Deprivation_Results.xlsx
*******************************************************************************************************************************************************************************************

capture log close
clear all
set more off
log using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/Ladder_extended_log.txt", text replace

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_All_Years_Adjusted.dta", clear
keep if inrange(year, 2018, 2024)
gen byte s_main = !missing(smd_grp, smd)
egen long hh_cl = group(year idhh)
svyset hh_cl [pw=dwt], vce(linearized)

*** Prepare the new variables
local numvars "PL016 PH020 PH040 PH060 PY021N PY130N PY120G PW010 PW191 PT220 PT230 PT240 PT210 PT190 PHD01 PHD06 PL025 PL020"
foreach v of local numvars {
    capture confirm variable `v'
    if _rc != 0 {
        di as error "`v' not in the dataset"
        gen double `v' = .
    }
    capture confirm string variable `v'
    if _rc == 0 {
        replace `v' = subinstr(`v', ",", ".", .)
        destring `v', replace force
    }
    gen byte av_`v' = !missing(`v')
}
foreach v in PB230 PB240 {
    capture confirm variable `v'
    if _rc != 0 {
        di as error "`v' not in the dataset"
        gen str3 `v' = ""
    }
    capture confirm string variable `v'
    if _rc != 0 {
        tostring `v', replace force
        replace `v' = "" if `v' == "."
    }
    replace `v' = strtrim(`v')
    gen byte av_`v' = (`v' != "")
    gen byte x_`v' = 99
    replace x_`v' = 1 if `v' == "LOC"
    replace x_`v' = 2 if `v' == "EU"
    replace x_`v' = 3 if `v' == "OTH"
}
* Categorical variables: original codes, missing = 99
foreach v in PL016 PH020 PH040 PH060 PT220 PT230 PT240 PT210 PT190 PHD01 PHD06 PL025 PL020 {
    gen int x_`v' = `v'
    replace x_`v' = 99 if missing(x_`v')
}
* Only asked of non-employed persons: IWP set to experience / not looking / not available
replace x_PL016 = 3 if smd_grp == 1 & missing(PL016)
replace x_PL020 = 2 if smd_grp == 1 & missing(PL020)
replace x_PL025 = 2 if smd_grp == 1 & missing(PL025)
* Amounts: receives the income component (> 0)
foreach v in PY021N PY130N PY120G {
    gen byte x_`v' = (`v' > 0 & !missing(`v'))
}
* Life satisfaction and trust: 0-5 / 6-7 / 8-10 and 0-4 / 5-6 / 7-10, missing = 99
gen byte x_PW010 = 99
replace x_PW010 = 1 if inrange(PW010, 0, 5)
replace x_PW010 = 2 if inrange(PW010, 6, 7)
replace x_PW010 = 3 if inrange(PW010, 8, 10)
gen byte x_PW191 = 99
replace x_PW191 = 1 if inrange(PW191, 0, 4)
replace x_PW191 = 2 if inrange(PW191, 5, 6)
replace x_PW191 = 3 if inrange(PW191, 7, 10)

*** Survey years per variable (> 50 % valid; PL016 / PL020 / PL025 checked among NEP, who are asked)
local allnew "PL016 PB230 PB240 PH020 PH040 PH060 PY021N PY130N PY120G PW010 PW191 PT220 PT230 PT240 PT210 PT190 PHD01 PHD06 PL025 PL020"
foreach v of local allnew {
    local base "s_main == 1"
    if inlist("`v'", "PL016", "PL020", "PL025") local base "s_main == 1 & smd_grp == 0"
    local yrs_`v' ""
    forvalues y = 2018/2024 {
        quietly summarize av_`v' if `base' & year == `y'
        if r(N) > 0 & r(mean) > 0.5 local yrs_`v' "`yrs_`v'' `y'"
    }
    di as text %-8s "`v'" " available in: `yrs_`v''"
}

