*******************************************************************************************************************************************************************************************
*** Title: Prepare EU-SILC longitudinal analysis files (same definitions as the cross-sectional scripts)
*** Input:  SILC_Long_All_Releases.dta (L01)
***         SILC_All_Years_Adjusted.dta (cross-sectional script 03) -> official-style poverty threshold by year
*** Output: SILC_Long_Prepared.dta  (all releases, one row per release x person x year)
***         SILC_Long_Panel.dta     (person-year panel: each person-year from the latest release containing it)
*** Definitions (as cross-sectional, adapted to what the longitudinal UDB provides):
***   - PL073-PL076 are not in the longitudinal UDB -> months from the monthly activity calendar PL211A-PL211L
***     (income reference year): codes 1-2 = employee, 3-4 = self-employed
***   - worker = >= 7 months as employee, age 18-64; any_worker = >= 7 months in any status, age 18-64
***   - RX060 / HX080 are not in the longitudinal UDB -> SMSD rebuilt from the 13 items (>= 7 of 13 lacking, all 13 valid);
***     same definition in all years; available 2018-2023 (no personal items before 2018)
***   - Variables released only for a release's final year (PD items, PE040, PL031 until 2020) are filled from the
***     release in which that person-year is the final year (same answers)
***   - Income: post = HY020 / HX050, pre = HY022 / HX050 (monthly, bounded at 0)
***   - Poverty threshold NOT computed from the panel sample (not cross-sectionally representative):
***     taken by year from the cross-sectional pipeline (60% of weighted median). Years without a
***     cross-sectional threshold get no poverty status.
***   - AROP w/o IWP as in all cross-sectional analyses: not working >= 7 months in any status, 18-64,
***     without old-age benefit recipients (PY100G > 0); identical in transitions, FE models and persistence
***   - Controls as in the cross-sectional deprivation models (M1-M12): age group, sex, household type (9),
***     income position, education (ISCED 3 groups), region (NUTS 1), urbanisation, health (PH010), limitation (PH030);
***     missing values as own category (9). Current economic status harmonised from PL031/PL032 (act_status)
***   - Limitation: the cross-sectional scripts use RX060 as provided (SMD until 2020, SMSD from 2021);
***     the longitudinal UDB has no RX060, so SMSD (13 items) is rebuilt for all years
*******************************************************************************************************************************************************************************************
clear all
set more off


********************************************************************************
* Poverty threshold by year from the cross-sectional file
********************************************************************************

* Stop with a clear message if the cross-sectional file is not available (e.g. iCloud file not downloaded)
capture confirm file "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_All_Years_Adjusted.dta"
if _rc != 0 {
    di as error "SILC_All_Years_Adjusted.dta not found: run the cross-sectional script 'HH incomes, poverty thresholds, poverty labels' first,"
    di as error "or download the file from iCloud (Finder: right click -> Download Now)"
    exit 601
}
use year poverty_threshold_rel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_All_Years_Adjusted.dta", clear
collapse (mean) poverty_threshold_rel, by(year)
list, noobs
tempfile thresholds
save `thresholds'


use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_All_Releases.dta", clear

********************************************************************************
* Destring (decimal comma -> point); create empty variable if not available
********************************************************************************

local numvars "RB060 RB062 RB063 RB064 RB080 RB090 RB110 RX010 HY020 HY022 HX050 PY100G PL211A PL211B PL211C PL211D PL211E PL211F PL211G PL211H PL211I PL211J PL211K PL211L HS011 HS021 HS031 HS040 HS050 HS060 HH050 HS110 HD080 PD020 PD030 PD050 PD060 PD070 PD080 DB100 PE040 PE041 PH010 PH030 PL031 PL032"

foreach var of local numvars {
    capture confirm variable `var'
    if _rc == 0 {
        capture confirm string variable `var'
        if _rc == 0 {
            replace `var' = subinstr(`var', ",", ".", .)
            destring `var', replace force
        }
    }
    else {
        gen double `var' = .
        di as text "`var' not found, created as missing"
    }
}

********************************************************************************
* Fill variables across releases (diagnostics L02b)
* The same person-year appears in up to four releases. Until 2020, several variables are only released
* for the final (cross-sectional) year of each release and are missing for the earlier years:
*   personal deprivation items PD020-PD080 (2018-2020), education PE040, economic status PL031;
*   DB040 / DB100 are missing for part of release 2023.
* Survey answers for a person-year do not differ between releases -> take the value from any release
********************************************************************************

foreach v in HS011 HS021 HS031 HS040 HS050 HS060 HH050 HS110 HD080 PD020 PD030 PD050 PD060 PD070 PD080 PE040 PE041 PL031 PL032 PH010 PH030 DB100 {
    capture drop fill_tmp
    bysort idperson year: egen fill_tmp = max(`v')
    quietly count if missing(`v') & !missing(fill_tmp)
    di as text "`v': " r(N) " person-year-release values filled from another release"
    replace `v' = fill_tmp if missing(`v')
    drop fill_tmp
}
capture confirm variable DB040
if _rc == 0 {
    capture confirm string variable DB040
    if _rc != 0 {
        tostring DB040, replace force
    }
    replace DB040 = strtrim(DB040)
    replace DB040 = "" if DB040 == "."
    gsort idperson year -DB040
    by idperson year: replace DB040 = DB040[1] if DB040 == ""
}

********************************************************************************
* Person ID, age, sex
********************************************************************************

* Person ID across releases (checked for consistency below)
egen long pid = group(idperson)
label variable pid "Person ID (RB030)"

gen dag = RX010
replace dag = year - RB080 if missing(dag) & !missing(RB080)
label variable dag "Age (RX010, else year - RB080)"

gen byte sex = RB090
label define sexlbl 1 "Male" 2 "Female"
label values sex sexlbl

********************************************************************************
* Months in income reference year from monthly activity calendar PL211A-PL211L
********************************************************************************

gen byte months_emp = 0
gen byte months_worked = 0
gen byte months_valid = 0
foreach m in A B C D E F G H I J K L {
    replace months_emp = months_emp + inlist(PL211`m', 1, 2)
    replace months_worked = months_worked + inlist(PL211`m', 1, 2, 3, 4)
    replace months_valid = months_valid + !missing(PL211`m')
}
replace months_emp = . if months_valid == 0
replace months_worked = . if months_valid == 0
label variable months_emp "Months as employee in income reference year (PL211A-L = 1/2)"
label variable months_worked "Months worked in any status (PL211A-L = 1-4)"

gen byte worker = (months_emp >= 7) if !missing(months_emp) & inrange(dag, 18, 64)
gen byte employed = (worker == 1)
gen byte any_worker = (months_worked >= 7) if !missing(months_worked) & inrange(dag, 18, 64)
replace any_worker = 0 if !inrange(dag, 18, 64)
label variable worker "Employee >= 7 months, age 18-64"
label variable employed "Worker (employee >= 7 months)"
label variable any_worker "Worked >= 7 months in any status, age 18-64"

gen byte oldage_ben = (PY100G > 0 & !missing(PY100G))
label variable oldage_ben "Receives old-age benefits (PY100G > 0)"

********************************************************************************
* Controls (as in the cross-sectional deprivation models); missing = own category 9
* Variable versions change in 2021 (PE040 -> PE041, PL031 -> PL032). Releases from 2021 may also report
* earlier years in the new variable (with the old coding) -> fall back to the other variable if missing
********************************************************************************

gen byte age_grp = .
replace age_grp = 1 if inrange(dag, 18, 29)
replace age_grp = 2 if inrange(dag, 30, 44)
replace age_grp = 3 if inrange(dag, 45, 54)
replace age_grp = 4 if inrange(dag, 55, 64)
label define agegrp 1 "18-29" 2 "30-44" 3 "45-54" 4 "55-64"
label values age_grp agegrp

* Education (ISCED): 1 = ISCED 0-2, 2 = ISCED 3-4, 3 = ISCED 5+
gen educ_isced = PE040 if year <= 2020
replace educ_isced = PE041 if year >= 2021
replace educ_isced = PE041 if missing(educ_isced) & year <= 2020
replace educ_isced = PE040 if missing(educ_isced) & year >= 2021
gen byte educ3 = 9
replace educ3 = 1 if inrange(educ_isced, 0, 299)
replace educ3 = 2 if inrange(educ_isced, 300, 499)
replace educ3 = 3 if educ_isced >= 500 & !missing(educ_isced)
label define educ3lbl 1 "ISCED 0-2" 2 "ISCED 3-4" 3 "ISCED 5+" 9 "Missing"
label values educ3 educ3lbl

* Region NUTS 1 (DB040, string)
capture confirm variable DB040
if _rc != 0 {
    gen str3 DB040 = ""
}
capture confirm string variable DB040
if _rc != 0 {
    tostring DB040, replace force
}
gen byte region = 9
replace region = 1 if strtrim(DB040) == "AT1"
replace region = 2 if strtrim(DB040) == "AT2"
replace region = 3 if strtrim(DB040) == "AT3"
label define regionlbl 1 "AT1 East" 2 "AT2 South" 3 "AT3 West" 9 "Missing"
label values region regionlbl

* Degree of urbanisation (DB100)
gen byte urban = DB100 if inlist(DB100, 1, 2, 3)
replace urban = 9 if missing(urban)
label define urbanlbl 1 "Cities" 2 "Towns and suburbs" 3 "Rural areas" 9 "Missing"
label values urban urbanlbl

* Health (PH010 bad / very bad) and limitation in activities (PH030)
gen byte health_bad = (inlist(PH010, 4, 5)) if inlist(PH010, 1, 2, 3, 4, 5)
replace health_bad = 9 if missing(health_bad)
label define healthlbl 0 "Very good to fair" 1 "Bad / very bad" 9 "Missing"
label values health_bad healthlbl
gen byte limit = PH030 if inlist(PH030, 1, 2, 3)
replace limit = 9 if missing(limit)
label define limitlbl 1 "Severely limited" 2 "Limited" 3 "Not limited" 9 "Missing"
label values limit limitlbl

* Current economic status, harmonised (as in the cross-sectional "Prepair EU-Silc Files")
gen ecs_old = PL031
replace ecs_old = PL032 if missing(ecs_old) & year <= 2020
gen ecs_new = PL032
gen byte act_status = 9
replace act_status = 1 if year <= 2020 & inlist(ecs_old, 1, 2, 3, 4)
replace act_status = 2 if year <= 2020 & ecs_old == 5
replace act_status = 3 if year <= 2020 & ecs_old == 6
replace act_status = 4 if year <= 2020 & ecs_old == 7
replace act_status = 5 if year <= 2020 & ecs_old == 8
replace act_status = 6 if year <= 2020 & ecs_old == 10
replace act_status = 7 if year <= 2020 & inlist(ecs_old, 9, 11)
replace act_status = 1 if year >= 2021 & ecs_new == 1
replace act_status = 2 if year >= 2021 & ecs_new == 2
replace act_status = 3 if year >= 2021 & ecs_new == 5
replace act_status = 4 if year >= 2021 & ecs_new == 3
replace act_status = 5 if year >= 2021 & ecs_new == 4
replace act_status = 6 if year >= 2021 & ecs_new == 6
replace act_status = 7 if year >= 2021 & inlist(ecs_new, 7, 8)
drop ecs_old ecs_new
label define actlbl 1 "Employed (current)" 2 "Unemployed" 3 "Pupil/student/training" 4 "Retired/early retired" 5 "Disabled/unable to work" 6 "Domestic tasks/care" 7 "Other inactive" 9 "Missing"
label values act_status actlbl

* Education is (almost) time-invariant for adults: fill remaining gaps (e.g. 2020 for persons not in release 2020)
* from the same person's nearest earlier, then later year
sort idperson year release
by idperson: replace educ3 = educ3[_n - 1] if educ3 == 9 & educ3[_n - 1] != 9 & _n > 1
gsort idperson -year -release
by idperson: replace educ3 = educ3[_n - 1] if educ3 == 9 & educ3[_n - 1] != 9 & _n > 1
sort idperson year release
tab year educ3 if inrange(dag, 18, 64), missing
tab year health_bad if inrange(dag, 18, 64), missing
tab year act_status if inrange(dag, 18, 64) & any_worker == 0 & oldage_ben == 0, missing

********************************************************************************
* SMSD rebuilt from the 13 items (1 = lacking because cannot afford)
********************************************************************************

gen byte dep_unexpected = (HS060 == 2) if inlist(HS060, 1, 2)
gen byte dep_holiday = (HS040 == 2) if inlist(HS040, 1, 2)
gen byte dep_meal = (HS050 == 2) if inlist(HS050, 1, 2)
gen byte dep_warm = (HH050 == 2) if inlist(HH050, 1, 2)
gen byte dep_car = (HS110 == 2) if inlist(HS110, 1, 2, 3)
gen byte dep_furniture = (HD080 == 2) if inlist(HD080, 1, 2, 3)
gen byte dep_arrears = (inlist(HS011, 1, 2) | inlist(HS021, 1, 2) | inlist(HS031, 1, 2)) if !missing(HS011) | !missing(HS021) | !missing(HS031)
gen byte dep_clothes = (PD020 == 2) if inlist(PD020, 1, 2, 3)
gen byte dep_shoes = (PD030 == 2) if inlist(PD030, 1, 2, 3)
gen byte dep_social = (PD050 == 2) if inlist(PD050, 1, 2, 3)
gen byte dep_leisure = (PD060 == 2) if inlist(PD060, 1, 2, 3)
gen byte dep_pocket = (PD070 == 2) if inlist(PD070, 1, 2, 3)
gen byte dep_internet = (PD080 == 2) if inlist(PD080, 1, 2, 3)

egen smsd_n = rowtotal(dep_unexpected dep_holiday dep_meal dep_warm dep_car dep_furniture dep_arrears dep_clothes dep_shoes dep_social dep_leisure dep_pocket dep_internet)
egen smsd_valid = rownonmiss(dep_unexpected dep_holiday dep_meal dep_warm dep_car dep_furniture dep_arrears dep_clothes dep_shoes dep_social dep_leisure dep_pocket dep_internet)
* SMSD only if all 13 items are valid. Personal items do not exist before 2018 (2015-2017: only the 7 household
* items) -> no SMSD for 2015-2017. (The former rule "or >= 7 lacking" classified persons lacking all 7 household
* items as deprived in years without personal items and biased the year effects.)
gen byte smd = (smsd_n >= 7) if smsd_valid == 13
label variable smd "Severe material and social deprivation (13 items rebuilt, >= 7 lacking)"

tab year smd, missing

********************************************************************************
* Income, poverty status (threshold from cross-sectional file)
********************************************************************************

gen double post_disp_hh_income_equ = max((HY020 / HX050) / 12, 0) if !missing(HY020, HX050) & HX050 > 0
gen double pre_disp_hh_income_equ = max((HY022 / HX050) / 12, 0) if !missing(HY022, HX050) & HX050 > 0

merge m:1 year using `thresholds', keep(master match) nogenerate

gen byte arop_post_rel = post_disp_hh_income_equ < poverty_threshold_rel if !missing(post_disp_hh_income_equ, poverty_threshold_rel)
gen byte arop_pre_rel = pre_disp_hh_income_equ < poverty_threshold_rel if !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen double inc_rel = 100 * post_disp_hh_income_equ / poverty_threshold_rel if !missing(post_disp_hh_income_equ, poverty_threshold_rel)
label variable inc_rel "Equivalised post-transfer income in % of poverty threshold"

tab year arop_post_rel, missing

********************************************************************************
* Household composition (children < 14), within release, year and current household
********************************************************************************

bysort release year idhh: egen n_children = total(dag < 14 & !missing(dag))
bysort release year idhh: egen n_adults = total(dag >= 14 & !missing(dag))

gen byte hh_type = .
replace hh_type = 1 if n_adults == 1 & n_children == 0
replace hh_type = 2 if n_adults == 1 & n_children == 1
replace hh_type = 3 if n_adults == 1 & n_children >= 2
replace hh_type = 4 if n_adults == 2 & n_children == 0
replace hh_type = 5 if n_adults == 2 & n_children == 1
replace hh_type = 6 if n_adults == 2 & n_children == 2
replace hh_type = 7 if n_adults == 2 & n_children >= 3
replace hh_type = 8 if n_adults >= 3 & n_children == 0
replace hh_type = 9 if n_adults >= 3 & n_children >= 1
label define hhtypelbl 1 "1 adult" 2 "1 adult + 1 child" 3 "1 adult + 2+ children" 4 "2 adults" 5 "2 adults + 1 child" 6 "2 adults + 2 children" 7 "2 adults + 3+ children" 8 "3+ adults" 9 "3+ adults + children"
label values hh_type hhtypelbl

********************************************************************************
* Groups and states (post-transfer, age 18-64)
* smd_grp: 1 = IWP Employees, 0 = AROP w/o IWP (both 18-64, without old-age benefit recipients) - identical to all cross-sectional analyses
* state:   1 = IWP Employee, 2 = AROP w/o IWP, 3 = not poor, 4 = other (poor self-employed, mixed, old-age benefits)
********************************************************************************

gen byte smd_grp = .
replace smd_grp = 1 if employed == 1 & arop_post_rel == 1 & oldage_ben == 0
replace smd_grp = 0 if any_worker == 0 & arop_post_rel == 1 & inrange(dag, 18, 64) & oldage_ben == 0
label define smdgrp 0 "AROP w/o IWP" 1 "IWP Employees"
label values smd_grp smdgrp

gen byte state = .
replace state = 1 if smd_grp == 1
replace state = 2 if smd_grp == 0
replace state = 3 if arop_post_rel == 0 & inrange(dag, 18, 64)
replace state = 4 if arop_post_rel == 1 & missing(smd_grp) & inrange(dag, 18, 64)
label define statelbl 1 "IWP Employee" 2 "AROP w/o IWP" 3 "Not poor" 4 "Other poor"
label values state statelbl

* Same groups before social transfers (pre = HY022 / HX050, same threshold): income dynamics pre and post
gen byte state_pre = .
replace state_pre = 1 if employed == 1 & arop_pre_rel == 1 & oldage_ben == 0
replace state_pre = 2 if any_worker == 0 & arop_pre_rel == 1 & inrange(dag, 18, 64) & oldage_ben == 0
replace state_pre = 3 if arop_pre_rel == 0 & inrange(dag, 18, 64)
replace state_pre = 4 if arop_pre_rel == 1 & missing(state_pre) & inrange(dag, 18, 64)
label values state_pre statelbl
label variable state_pre "Group before social transfers (pre-transfer income)"
tab year state_pre, missing

tab year state, missing

save "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", replace

********************************************************************************
* Person-year panel: each person-year from the latest release that contains it
* ID consistency check: sex and birth year must be constant within pid
********************************************************************************

bysort pid year (release): keep if _n == _N

bysort pid: egen sd_birth = sd(RB080)
bysort pid: egen sd_sex = sd(RB090)
gen byte id_inconsistent = (sd_birth > 0 & !missing(sd_birth)) | (sd_sex > 0 & !missing(sd_sex))
di _n as result "=== ID consistency across releases (share of persons with changing sex / birth year) ==="
egen byte pid_tag = tag(pid)
tab id_inconsistent if pid_tag == 1
* If this share is not close to 0, person IDs are not consistent across releases:
* the panel analyses in L03 then exclude these persons (id_inconsistent == 1)
drop sd_birth sd_sex pid_tag

xtset pid year
xtdescribe if inrange(dag, 18, 64)

save "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Panel.dta", replace
