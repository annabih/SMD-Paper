*******************************************************************************************************************************************************************************************
*** PART E: KHB decomposition per model (point estimates; standard errors from khb in Part G)
*******************************************************************************************************************************************************************************************

* One decomposition; uses globals YVAR (outcome), BLOCKS, XFV, MD1-MD8
capture program drop med_khb
program define med_khb, rclass
    tempname bm
    local allm ""
    foreach k of global BLOCKS {
        local allm "`allm' ${MD`k'}"
    }
    * full model: direct effect c' and b-paths
    quietly logit $YVAR i.smd_grp $XFV `allm' [pw=dwt] if s_med == 1
    local bdir = _b[1.smd_grp]
    local j = 0
    foreach z of local allm {
        local j = `j' + 1
        local beta`j' = _b[`z']
    }
    quietly margins, dydx(smd_grp)
    matrix `bm' = r(b)
    local adir = 100 * `bm'[1, colnumb(`bm', "1.smd_grp")]
    quietly margins, at(smd_grp = 0)
    matrix `bm' = r(b)
    local p0d = 100 * `bm'[1, 1]
    * a-paths, residualised mediators, block contributions a * b
    local rlist ""
    local j = 0
    foreach k of global BLOCKS {
        local c`k' = 0
        foreach z of global MD`k' {
            local j = `j' + 1
            quietly regress `z' i.smd_grp $XFV [pw=dwt] if s_med == 1
            local c`k' = `c`k'' + _b[1.smd_grp] * `beta`j''
            tempvar r`j'
            quietly predict double `r`j'' if s_med == 1, residuals
            local rlist "`rlist' `r`j''"
        }
    }
    * reduced model with residualised mediators: total effect c on the same scale
    quietly logit $YVAR i.smd_grp $XFV `rlist' [pw=dwt] if s_med == 1
    local btot = _b[1.smd_grp]
    quietly margins, dydx(smd_grp)
    matrix `bm' = r(b)
    local atot = 100 * `bm'[1, colnumb(`bm', "1.smd_grp")]
    quietly margins, at(smd_grp = 0)
    matrix `bm' = r(b)
    local p0t = 100 * `bm'[1, 1]
    local bind = `btot' - `bdir'
    local aind = `atot' - `adir'
    return scalar btot = `btot'
    return scalar bdir = `bdir'
    return scalar bind = `bind'
    return scalar sdir = 100 * `bdir' / `btot'
    return scalar sind = 100 * `bind' / `btot'
    return scalar atot = `atot'
    return scalar adir = `adir'
    return scalar aind = `aind'
    return scalar rtot = 100 * `atot' / `p0t'
    return scalar rdir = 100 * `adir' / `p0d'
    return scalar rind = 100 * `aind' / `p0t'
    local csum = 0
    foreach k of global BLOCKS {
        local csum = `csum' + `c`k''
        return scalar c`k' = `c`k''
        return scalar s`k' = 100 * `c`k'' / `btot'
        return scalar pp`k' = `c`k'' / `bind' * `aind'
        return scalar rel`k' = 100 * (`c`k'' / `bind' * `aind') / `p0t'
    }
    * check: c - c' - sum a * b, should be ~0
    return scalar check = `bind' - `csum'
end

* Table of one decomposition (point estimates; identical to the official khb command in Part G)
capture program drop med_table
program define med_table
    args run blocks
    global BLOCKS "`blocks'"
    med_khb
    di _n as result "=== KHB model `run': blocks `blocks' ===" _n as text "check (c - c' - sum a*b, should be ~0): " %12.10f r(check)
    foreach k of local blocks {
        post med_dec ("`run'") ("via ${LBL`k'}") (r(c`k')) (r(s`k')) (r(pp`k')) (r(rel`k'))
        di as text %-26s "via ${LBL`k'}" " logit " %7.3f r(c`k') "  share of gap " %6.1f r(s`k') " %  " %6.2f r(pp`k') " pp  " %6.1f r(rel`k') " % of NEP"
    }
    post med_dec ("`run'") ("indirect") (r(bind)) (r(sind)) (r(aind)) (r(rind))
    post med_dec ("`run'") ("direct c'") (r(bdir)) (r(sdir)) (r(adir)) (r(rdir))
    post med_dec ("`run'") ("total c") (r(btot)) (100) (r(atot)) (r(rtot))
    di as text %-26s "indirect" " logit " %7.3f r(bind) "  share of gap " %6.1f r(sind) " %  " %6.2f r(aind) " pp  " %6.1f r(rind) " % of NEP"
    di as text %-26s "direct c'" " logit " %7.3f r(bdir) "  share of gap " %6.1f r(sdir) " %  " %6.2f r(adir) " pp  " %6.1f r(rdir) " % of NEP"
    di as text %-26s "total c" " logit " %7.3f r(btot) "  share of gap " %6.1f 100 " %  " %6.2f r(atot) " pp  " %6.1f r(rtot) " % of NEP"
end

foreach run of global RUNS {
    med_table "`run'" "${BLOCKS_`run'}"
}

*******************************************************************************************************************************************************************************************
*** PART G: Standard errors with the official khb command (delta method): total c (Reduced), direct c' (Full), indirect (Diff),
***         contribution of each mediator (disentangle), share mediated (summary); probability scale with option ape
*******************************************************************************************************************************************************************************************

med_expand $XFV, prefix(_x_)
global XD "`r(list)'"
foreach run of global RUNS {
    global MM ""
    foreach k of global BLOCKS_`run' {
        global MM "$MM ${MD`k'}"
    }
    di _n as result "=== khb model `run' (blocks ${BLOCKS_`run'}): logit scale, contribution of each mediator ==="
    capture noisily khb logit smd smd_grp || $MM if s_med == 1 [pw=dwt], concomitant($XD) vce(cluster hh_cl) summary disentangle
    di _n as result "=== khb model `run' (blocks ${BLOCKS_`run'}): probability scale (APE) ==="
    capture noisily khb logit smd smd_grp || $MM if s_med == 1 [pw=dwt], concomitant($XD) vce(cluster hh_cl) ape
}

*******************************************************************************************************************************************************************************************
*** PART G2: Item-level decomposition - the main model C for each of the 13 SMSD items
***   Which items does the gap consist of, and which type of transfer explains which items? E.g. if means-tested benefits
***   mainly explain items that need reserves (unexpected expenses, holiday, furniture), this points to asset tests / missing
***   savings; if they explain arrears or basic needs, rather to low or irregular payments.
***   p-values of the total (Reduced), direct (Full) and indirect (Diff) effect from khb (logit scale), Holm-adjusted across
***   the 13 items for the indirect effect at export. Shares are unstable for items with a small total gap.
*******************************************************************************************************************************************************************************************

global MM_C ""
foreach k of global BLOCKS_C {
    global MM_C "$MM_C ${MD`k'}"
}
global BLOCKS "$BLOCKS_C"
local items "dep_unexpected dep_holiday dep_furniture dep_car dep_arrears dep_meal dep_warm dep_leisure dep_pocket dep_clothes dep_social dep_internet dep_shoes"
local ord = 0
foreach y of local items {
    local ord = `ord' + 1
    global YVAR "`y'"
    quietly med_khb
    local p0 = 100 * r(atot) / r(rtot)
    local tot_pp = r(atot)
    local tot_rel = r(rtot)
    local ind_pp = r(aind)
    local ind_rel = r(rind)
    local ind_share = r(sind)
    local dir_pp = r(adir)
    local dir_rel = r(rdir)
    forvalues k = 1/8 {
        local s`k' = .
        local pp`k' = .
    }
    local vialine ""
    foreach k of global BLOCKS {
        local s`k' = r(s`k')
        local pp`k' = r(pp`k')
        local sf : display %5.1f `s`k''
        local pf : display %5.2f `pp`k''
        local vialine "`vialine' | ${LBL`k'} `sf' % (`pf' pp)"
    }
    local lab : variable label `y'
    di _n(2) as result "=================== Item: `y' (`lab') ==================="
    local tot_p = .
    local ind_p = .
    local dir_p = .
    capture noisily khb logit `y' smd_grp || $MM_C if s_med == 1 [pw=dwt], concomitant($XD) vce(cluster hh_cl) disentangle
    if _rc == 0 {
        capture local tot_p = 2 * normal(-abs(_b[smd_grp:Reduced] / _se[smd_grp:Reduced]))
        capture local dir_p = 2 * normal(-abs(_b[smd_grp:Full] / _se[smd_grp:Full]))
        capture local ind_p = 2 * normal(-abs(_b[smd_grp:Diff] / _se[smd_grp:Diff]))
    }
    post med_items (`ord') ("`y'") ("`lab'") (`p0') (`tot_pp') (`tot_rel') (`tot_p') (`ind_pp') (`ind_rel') (`ind_share') (`ind_p') (`dir_pp') (`dir_rel') (`dir_p') (`s1') (`pp1') (`s2') (`pp2') (`s3') (`pp3') (`s4') (`pp4') (`s5') (`pp5') (`s6') (`pp6') (`s7') (`pp7') (`s8') (`pp8')
    di as text "NEP rate " %5.1f `p0' " % | total " %6.2f `tot_pp' " pp (" %6.1f `tot_rel' " %, p=" %5.3f `tot_p' ") | indirect " %6.2f `ind_pp' " pp (" %5.1f `ind_share' " % of gap, p=" %5.3f `ind_p' ") | direct " %6.2f `dir_pp' " pp (" %6.1f `dir_rel' " %, p=" %5.3f `dir_p' ")"
    di as text " `vialine'"
}
