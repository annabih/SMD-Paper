*******************************************************************************************************************************************************************************************
*** Title: Prepare EU-SILC analysis file (MA-II logic on EU-SILC)
*** Replaces: "Create pre post policy file"
*** Aim: Destring, weights, age, worker definition (months in income reference year), old-age benefits, SMD (RX060), AROPE (RX070)
*** Note: No policy scenario exists on EU-SILC, therefore no append and no scenario variable
*** Input: SILC_CrossSec_All_Years.dta (from script 01)
*** Output: SILC_All_Years_Prepared.dta
*** Definitions (checked against EU-SILC UDB codebooks 2017-2024):
***   - worker = >= 7 months as employee (PL073 + PL074) in income reference year, age 18-64
***     no emp_status (PL040/PL040A) condition: PL040 (2015-2020) is filled for anyone who ever worked,
***     PL040A (2021-2024) only for the currently employed -> not consistent across years
***   - any_worker = >= 7 months in any status (PL073-PL076), age 18-64 -> excluded from comparison group
***   - RX060 used as provided in the UDB for all years
***   - RX070 = 3-digit code (hundreds = AROP, tens = SMD/SMSD, ones = LWI); same break in 2021
*******************************************************************************************************************************************************************************************
clear all
set more off


use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_CrossSec_All_Years.dta", clear

********************************************************************************
* Destring (decimal comma -> point); create empty variable if not available
********************************************************************************

local numvars "HY020 HY022 HX050 HX090 HX080 RB050 RB090 RX010 PX010 PL073 PL074 PL075 PL076 PY100G RX060 RX070 DB100 PE040 PE041 PH010 PH030"

foreach var of local numvars {
    capture confirm variable `var'
    if _rc == 0 {
        capture confirm string variable `var'
        if _rc == 0 {
            replace `var' = subinstr(`var', ",", ".", .)
            destring `var', replace force
        }
    }
    else {
        gen double `var' = .
        di as text "`var' not found, created as missing"
    }
}

********************************************************************************
* Weight and age (EUROMOD dwt / dag equivalents)
********************************************************************************

* RB050 missing = RB110 not 1-4 (person no longer in household) -> not part of cross-sectional population
count if missing(RB050)
drop if missing(RB050)

gen double dwt = RB050
label variable dwt "Personal cross-sectional weight (RB050)"

* Sex (R file, available for all persons incl. children)
gen byte sex = RB090
label define sexlbl 1 "Male" 2 "Female"
label values sex sexlbl
label variable sex "Sex (RB090)"

gen dag = RX010
replace dag = PX010 if missing(dag)
label variable dag "Age (RX010, else PX010)"

********************************************************************************
* Months in income reference year (PL073-PL076), capped at 12
********************************************************************************

* Months as employee (full-time + part-time)
egen months_emp = rowtotal(PL073 PL074), missing
replace months_emp = 12 if months_emp > 12 & !missing(months_emp)
label variable months_emp "Months as employee in income reference year (PL073+PL074)"

* Months worked in any status (employee or self-employed)
egen months_worked = rowtotal(PL073 PL074 PL075 PL076), missing
replace months_worked = 12 if months_worked > 12 & !missing(months_worked)
label variable months_worked "Months worked in any status (PL073-PL076)"

********************************************************************************
* Worker = >= 7 months as employee, age 18-64 (no emp_status condition)
* any_worker = >= 7 months in any status, age 18-64 (excluded from comparison group)
********************************************************************************

gen byte worker = (months_emp >= 7) if !missing(months_emp) & inrange(dag, 18, 64)
label variable worker "Employee >= 7 months in income reference year, age 18-64"

gen byte employed = (worker == 1)
label variable employed "Worker (employee >= 7 months), used as filter in scripts 03/04"

* 18-64 with missing months stay missing (not counted as non-workers); outside 18-64 = 0
gen byte any_worker = (months_worked >= 7) if !missing(months_worked) & inrange(dag, 18, 64)
replace any_worker = 0 if !inrange(dag, 18, 64)
label variable any_worker "Worked >= 7 months in any status, age 18-64"
count if inrange(dag, 18, 64) & missing(months_worked)

tab year employed if inrange(dag, 18, 64), missing
tab employed any_worker if inrange(dag, 18, 64), missing

********************************************************************************
* Old-age benefits in income reference year (person level)
* Missing (e.g. children without P record) -> 0
* Survivor benefits (PY110G) are deliberately kept in the comparison group
********************************************************************************

gen byte oldage_ben = (PY100G > 0 & !missing(PY100G))
label variable oldage_ben "Receives old-age benefits (PY100G > 0)"

tab year oldage_ben if inrange(dag, 18, 64) & any_worker == 0, missing

********************************************************************************
* RX060 used as provided in the UDB (label changes 2021 from SMD to SMSD)
* RX070: 3-digit code (hundreds = AROP, tens = SMD/SMSD, ones = LWI)
********************************************************************************

gen byte smd = RX060 if inlist(RX060, 0, 1)
label variable smd "Severe material and social deprivation (RX060, used as provided)"

gen byte arope = (RX070 > 0) if !missing(RX070)
label variable arope "AROPE, RX070 > 0"

gen byte arope_arp = (floor(RX070 / 100) == 1) if !missing(RX070)
gen byte arope_smd = (mod(floor(RX070 / 10), 10) == 1) if !missing(RX070)
gen byte arope_lwi = (mod(RX070, 10) == 1) if !missing(RX070)
label variable arope_arp "AROPE component: at risk of poverty"
label variable arope_smd "AROPE component: severe (material and social) deprivation"
label variable arope_lwi "AROPE component: low work intensity"

tab year smd, missing
tab year arope, missing

********************************************************************************
* Additional controls for the deprivation models (M5, M6) and sector analysis
* Missing values are kept as an own category (9) so that N stays constant across models
********************************************************************************

* Education (ISCED): PE040 (2015-2020), PE041 (2021-2024)
* 1 = at most lower secondary (ISCED 0-2), 2 = upper/post-secondary (ISCED 3-4), 3 = tertiary (ISCED 5+)
gen educ_isced = PE040 if year <= 2020
replace educ_isced = PE041 if year >= 2021
gen byte educ3 = 9
replace educ3 = 1 if inrange(educ_isced, 0, 299)
replace educ3 = 2 if inrange(educ_isced, 300, 499)
replace educ3 = 3 if educ_isced >= 500 & !missing(educ_isced)
label define educ3lbl 1 "ISCED 0-2" 2 "ISCED 3-4" 3 "ISCED 5+" 9 "Missing"
label values educ3 educ3lbl
label variable educ3 "Education (PE040/PE041), 3 groups"

* Region: NUTS 1 (DB040: AT1 East, AT2 South, AT3 West)
capture confirm variable DB040
if _rc != 0 {
    gen str3 DB040 = ""
}
gen byte region = 9
replace region = 1 if strtrim(DB040) == "AT1"
replace region = 2 if strtrim(DB040) == "AT2"
replace region = 3 if strtrim(DB040) == "AT3"
label define regionlbl 1 "AT1 East" 2 "AT2 South" 3 "AT3 West" 9 "Missing"
label values region regionlbl
label variable region "Region NUTS 1 (DB040)"

* Degree of urbanisation (DB100): 1 cities, 2 towns and suburbs, 3 rural areas
gen byte urban = DB100 if inlist(DB100, 1, 2, 3)
replace urban = 9 if missing(urban)
label define urbanlbl 1 "Cities" 2 "Towns and suburbs" 3 "Rural areas" 9 "Missing"
label values urban urbanlbl
label variable urban "Degree of urbanisation (DB100)"

* Health: general health bad/very bad (PH010 = 4, 5); limitation in activities (PH030)
gen byte health_bad = (inlist(PH010, 4, 5)) if inlist(PH010, 1, 2, 3, 4, 5)
replace health_bad = 9 if missing(health_bad)
label define healthlbl 0 "Very good to fair" 1 "Bad / very bad" 9 "Missing"
label values health_bad healthlbl
label variable health_bad "General health bad or very bad (PH010)"

gen byte limit = PH030 if inlist(PH030, 1, 2, 3)
replace limit = 9 if missing(limit)
label define limitlbl 1 "Severely limited" 2 "Limited" 3 "Not limited" 9 "Missing"
label values limit limitlbl
label variable limit "Limitation in activities because of health (PH030)"

* Sector of main job (NACE, 13 groups): PL111 (2015-2020), PL111A (2021-2024)
* Only defined for persons with a job -> used within IWP Employees only, never as control in the group comparison
* Robust coding: the UDB may store sections as letters ("a", "b-e", ...) or as codes 1-13;
* letters are normalised (lower case, no blanks) before mapping
gen byte sector = .
foreach v in PL111 PL111A {
    capture confirm variable `v'
    if _rc == 0 {
        capture confirm string variable `v'
        if _rc != 0 {
            tostring `v', replace force
        }
        capture drop sec_s
        gen sec_s = lower(subinstr(subinstr(strtrim(`v'), " ", "", .), "_", "-", .))
        if "`v'" == "PL111" local yrs "year <= 2020"
        if "`v'" == "PL111A" local yrs "year >= 2021"
        * letters
        replace sector = 1 if `yrs' & sec_s == "a"
        replace sector = 2 if `yrs' & inlist(sec_s, "b-e", "be", "b", "c", "d", "e")
        replace sector = 3 if `yrs' & sec_s == "f"
        replace sector = 4 if `yrs' & sec_s == "g"
        replace sector = 5 if `yrs' & sec_s == "h"
        replace sector = 6 if `yrs' & sec_s == "i"
        replace sector = 7 if `yrs' & sec_s == "j"
        replace sector = 8 if `yrs' & sec_s == "k"
        replace sector = 9 if `yrs' & inlist(sec_s, "l-n", "ln", "l", "m", "n")
        replace sector = 10 if `yrs' & sec_s == "o"
        replace sector = 11 if `yrs' & sec_s == "p"
        replace sector = 12 if `yrs' & sec_s == "q"
        replace sector = 13 if `yrs' & inlist(sec_s, "r-u", "ru", "r", "s", "t", "u")
        * numeric codes 1-13
        capture drop sec_n
        gen sec_n = real(sec_s)
        replace sector = sec_n if `yrs' & missing(sector) & inrange(sec_n, 1, 13)
        di _n "=== Raw values of `v' (persons with a job) ==="
        tab sec_s if `yrs' & employed == 1, missing
        drop sec_s sec_n
    }
}
label define sectorlbl 1 "A Agriculture" 2 "B-E Industry" 3 "F Construction" 4 "G Trade" 5 "H Transport" 6 "I Accommodation/food" 7 "J Information/communication" 8 "K Finance" 9 "L-N Real estate/business services" 10 "O Public administration" 11 "P Education" 12 "Q Health/social work" 13 "R-U Arts/other services"
label values sector sectorlbl
label variable sector "Sector of main job (NACE, PL111/PL111A)"

tab year educ3 if inrange(dag, 18, 64), missing
tab year region, missing
tab year urban, missing
tab year health_bad if inrange(dag, 18, 64), missing
tab year limit if inrange(dag, 18, 64), missing
tab year sector if employed == 1, missing

save "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_All_Years_Prepared.dta", replace
