*******************************************************************************************************************************************************************************************
*** Title: Panel analyses - does employment protect against deprivation beyond income? (EU-SILC longitudinal, Austria)
*** Aim: Within-person evidence complementing the cross-sectional comparison IWP Employees vs. AROP w/o IWP
***   PART A: Panel structure - persons, years per person, switchers between the two groups
***   PART B: Transitions t-1 -> t (each release's last year pair, two-year weight RB062)
***           B1 transition matrix between states; B2 SMD before/after by path;
***           B3 difference-in-differences: entering work while staying poor (AxI -> IWP vs. AxI -> AxI)
***              and losing work while staying poor (IWP -> AxI vs. IWP -> IWP), with and without change in income position
***   PART C: Fixed-effects models (person-year panel): SMD on group within the same person
***           C1 linear FE among the poor (IWP vs. AxI), same control ladder as the cross-section:
***              M1 year FE, M2-M10 year FE + one control each, M11 all controls, M12 all except health
***              (time-invariant controls such as sex are absorbed by the person FE -> M3 = M1)
***           C2 conditional (FE) logit for M1, M11, M12; C3 linear FE all 18-64 with states (M11 controls)
***           C4 item decomposition: linear FE per SMSD item (M1, M11, M12), Holm-adjusted across the 13 items
***   PART D: Descriptive poverty and deprivation dynamics (main use of the panel)
***           D1 income poverty over 4 years (RB064) and 3 years (RB063): years poor, persistent poverty, by group in the last year
***           D2 group stability: years as IWP Employee / AROP w/o IWP
***           D3 SMSD over 3 years (RB063; SMSD from 2018 only): years in SMSD, persistent SMSD, share of the deprived already deprived before
***           D4 year-to-year SMSD entry and exit rates by group (two-year weight RB062)
*** Notes:
***   - Levels (rates, gaps, bands) stay in the cross-sectional scripts; this script is about change within persons
***   - FE models are unweighted with person-clustered SE (standard for FE; longitudinal weights differ by release)
***   - Effects reported in pp and as relative change in % (relative to the comparison group's level)
***   - Groups as in all cross-sectional analyses: IWP Employees and AROP w/o IWP, both 18-64, without old-age benefits
*** Input: SILC_Long_Prepared.dta, SILC_Long_Panel.dta (L02)
*** Output: L03_Panel_log.txt
*******************************************************************************************************************************************************************************************

capture log close
clear all
set more off

log using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/L03_Panel_log.txt", text replace


*******************************************************************************************************************************************************************************************
*** PART A: Panel structure
*******************************************************************************************************************************************************************************************

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Panel.dta", clear
keep if id_inconsistent == 0
xtset pid year

di _n(2) as result "=================== PART A: Panel structure ==================="

*** Person-years by year and state (18-64)
tab year state if inrange(dag, 18, 64)

*** Years observed per person (18-64)
bysort pid: egen n_years = total(inrange(dag, 18, 64))
egen byte pid_tag = tag(pid)
tab n_years if pid_tag == 1 & n_years > 0

*** Switchers: persons observed both as IWP Employee and as AROP w/o IWP (they identify the FE effect)
bysort pid: egen grp_min = min(smd_grp)
bysort pid: egen grp_max = max(smd_grp)
gen byte switcher = (grp_min == 0 & grp_max == 1)
di _n as result "Persons ever in one of the two groups, and switchers between them:"
count if pid_tag == 1 & !missing(grp_min)
count if pid_tag == 1 & switcher == 1
* Person-years of switchers by group and SMD
tab smd_grp smd if switcher == 1, row

*** Composition of AROP w/o IWP person-years by current economic status (as cross-sectional Part 6)
tab act_status if smd_grp == 0
*** Status of switchers while in AROP w/o IWP (who identifies the FE effect?)
tab act_status if smd_grp == 0 & switcher == 1


*******************************************************************************************************************************************************************************************
*** PART B: Transitions t-1 -> t
*** Each release contributes its last year pair (release - 1 -> release), weighted with its two-year weight RB062
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART B: Transitions ==================="

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear

bysort release pid (year): gen byte state_lag = state[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen byte smd_lag = smd[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen double inc_rel_lag = inc_rel[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen byte act_lag = act_status[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen byte n_children_lag = n_children[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen byte n_adults_lag = n_adults[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen byte health_lag = health_bad[_n - 1] if year[_n - 1] == year - 1
bysort release pid (year): gen byte limit_lag = limit[_n - 1] if year[_n - 1] == year - 1

keep if year == release & RB062 > 0 & !missing(RB062) & !missing(state, state_lag)

tab release

*** B1: Transition matrix (row %: where do persons in state t-1 end up in t?)
tab state_lag state [aw=RB062], row nofreq
tab state_lag state

*** B2: SMD before and after, by path (IWP / AxI at t-1)
gen int path = 10 * state_lag + state
label define pathlbl 11 "IWP -> IWP" 12 "IWP -> AxI" 13 "IWP -> not poor" 14 "IWP -> other" 21 "AxI -> IWP" 22 "AxI -> AxI" 23 "AxI -> not poor" 24 "AxI -> other"
label values path pathlbl
table path if inlist(state_lag, 1, 2) & !missing(smd, smd_lag) [aw=RB062], statistic(mean smd_lag) statistic(mean smd) statistic(frequency) nformat(%9.4f mean)

*** Who enters work while staying poor? Status at t-1 of AxI -> IWP movers vs. AxI -> AxI stayers (column %)
tab act_lag path if inlist(path, 21, 22), col nofreq
tab act_lag path if inlist(path, 21, 22)

*** D4 (computed here, uses the transition file): year-to-year SMSD entry and exit rates by group in t
* Entry: share with SMSD in t among those without SMSD in t-1; exit: share without SMSD in t among those with SMSD in t-1
di _n as result "--- D4: SMSD entry rate (no SMSD in t-1 -> SMSD in t), by state in t ---"
table state if smd_lag == 0 & !missing(smd) & inlist(state, 1, 2, 3) [aw=RB062], statistic(mean smd) statistic(frequency) nformat(%9.4f mean)
di _n as result "--- D4: SMSD exit rate (SMSD in t-1 -> no SMSD in t), by state in t ---"
capture drop smd_exit
gen byte smd_exit = (smd == 0) if smd_lag == 1 & !missing(smd)
table state if inlist(state, 1, 2, 3) [aw=RB062], statistic(mean smd_exit) statistic(frequency) nformat(%9.4f mean)

*** B3: Difference-in-differences on the change in SMD (dsmd x 100 = pp)
gen double dsmd = 100 * (smd - smd_lag) if !missing(smd, smd_lag)
gen double dinc_rel = inc_rel - inc_rel_lag if !missing(inc_rel, inc_rel_lag)
gen double dn_children = n_children - n_children_lag if !missing(n_children, n_children_lag)
gen double dn_adults = n_adults - n_adults_lag if !missing(n_adults, n_adults_lag)
* Health change: 1 = worse, 0 = same, -1 = better (bad/very bad health; limitation severely/limited); missing category kept out
gen byte dhealth = (health_bad == 1) - (health_lag == 1) if inlist(health_bad, 0, 1) & inlist(health_lag, 0, 1)
gen byte dlimit = (inlist(limit, 1, 2)) - (inlist(limit_lag, 1, 2)) if inlist(limit, 1, 2, 3) & inlist(limit_lag, 1, 2, 3)


* B3a: entering work while staying poor (AxI -> IWP) vs. staying non-working poor (AxI -> AxI)
capture drop move
gen byte move = (state == 1) if state_lag == 2 & inlist(state, 1, 2)
di _n as result "--- B3a: AxI -> IWP vs. AxI -> AxI (change in SMD, pp) ---"
regress dsmd i.move i.release [pw=RB062], vce(cluster pid)
quietly sum smd_lag [aw=RB062] if move == 1
local base_a = 100 * r(mean)
di as result "Baseline SMD of movers (t-1): " %6.2f `base_a' " %;  DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_a') " %"
di _n as result "--- B3a with change in income position (beyond income) ---"
regress dsmd i.move c.dinc_rel i.release [pw=RB062], vce(cluster pid)
di as result "DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_a') " %"
di _n as result "--- B3a with changes in income position, household composition and health (as M11) ---"
regress dsmd i.move c.dinc_rel c.dn_children c.dn_adults c.dhealth c.dlimit i.release [pw=RB062], vce(cluster pid)
di as result "DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_a') " %"
di _n as result "--- B3a with changes in income position and household composition, without health (as M12) ---"
regress dsmd i.move c.dinc_rel c.dn_children c.dn_adults i.release [pw=RB062], vce(cluster pid)
di as result "DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_a') " %"

* B3b: losing work while staying poor (IWP -> AxI) vs. staying working poor (IWP -> IWP)
capture drop move
gen byte move = (state == 2) if state_lag == 1 & inlist(state, 1, 2)
di _n as result "--- B3b: IWP -> AxI vs. IWP -> IWP (change in SMD, pp) ---"
regress dsmd i.move i.release [pw=RB062], vce(cluster pid)
quietly sum smd_lag [aw=RB062] if move == 1
local base_b = 100 * r(mean)
di as result "Baseline SMD of movers (t-1): " %6.2f `base_b' " %;  DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_b') " %"
di _n as result "--- B3b with change in income position (beyond income) ---"
regress dsmd i.move c.dinc_rel i.release [pw=RB062], vce(cluster pid)
di as result "DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_b') " %"
di _n as result "--- B3b with changes in income position, household composition and health (as M11) ---"
regress dsmd i.move c.dinc_rel c.dn_children c.dn_adults c.dhealth c.dlimit i.release [pw=RB062], vce(cluster pid)
di as result "DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_b') " %"
di _n as result "--- B3b with changes in income position and household composition, without health (as M12) ---"
regress dsmd i.move c.dinc_rel c.dn_children c.dn_adults i.release [pw=RB062], vce(cluster pid)
di as result "DiD relative to baseline: " %6.1f (100 * _b[1.move] / `base_b') " %"

* Cell sizes (check before interpreting)
tab state_lag state if inlist(state_lag, 1, 2) & inlist(state, 1, 2) & !missing(dsmd)


*******************************************************************************************************************************************************************************************
*** PART C: Fixed-effects models (person-year panel, latest release per person-year)
*** Identified only from persons who change group / state over time (see switchers in PART A)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART C: Fixed effects ==================="

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Panel.dta", clear
keep if id_inconsistent == 0
xtset pid year

* Comparison level for relative change: SMD share of AROP w/o IWP person-years
quietly sum smd if smd_grp == 0
local base_c = 100 * r(mean)
di as result "SMD share among AROP w/o IWP person-years: " %6.2f `base_c' " %"

* Control ladder as in the cross-sectional deprivation models
local c1 "i.year"
local c2 "i.year i.age_grp"
local c3 "i.year i.sex"
local c4 "i.year i.hh_type"
local c5 "i.year c.inc_rel"
local c6 "i.year i.educ3"
local c7 "i.year i.region"
local c8 "i.year i.urban"
local c9 "i.year i.health_bad"
local c10 "i.year i.limit"
local c11 "i.year i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban i.health_bad i.limit"
local c12 "i.year i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban"

tempname pc
tempfile res_c
postfile `pc' str6 part str16 outcome str4 model double(n n_pers b se p pp rel) using `res_c', replace

*** C1: Linear FE among the poor (IWP Employees vs. AROP w/o IWP); coefficient x 100 = pp
forvalues m = 1/12 {
    di _n as result "--- C1 M`m': FE, `c`m'' ---"
    xtreg smd i.smd_grp `c`m'' if !missing(smd_grp), fe vce(cluster pid)
    local b = _b[1.smd_grp]
    local se = _se[1.smd_grp]
    local p = 2 * ttail(e(df_r), abs(`b' / `se'))
    di as result "M`m' IWP vs. AxI within person: " %6.2f (100 * `b') " pp (SE " %4.2f (100 * `se') "), " %6.1f (100 * 100 * `b' / `base_c') " % relative to AxI level, p = " %6.4f `p'
    post `pc' ("C1") ("smd") ("M`m'") (e(N)) (e(N_g)) (`b') (`se') (`p') (100 * `b') (100 * 100 * `b' / `base_c')
}

*** C2: Conditional (FE) logit - odds ratios; uses only persons who change in smd and group
foreach m in 1 11 12 {
    di _n as result "--- C2 M`m': FE logit (odds ratios), `c`m'' ---"
    capture noisily xtlogit smd i.smd_grp `c`m'' if !missing(smd_grp), fe or
    if _rc == 0 {
        post `pc' ("C2") ("smd") ("M`m'") (e(N)) (e(N_g)) (_b[1.smd_grp]) (_se[1.smd_grp]) (2 * normal(-abs(_b[1.smd_grp] / _se[1.smd_grp]))) (.) (.)
    }
}

*** C3: Linear FE for all 18-64 with states (reference: AROP w/o IWP), M11 controls
di _n as result "--- C3: FE, all 18-64, states (ref. AxI), M11 controls ---"
xtreg smd ib2.state `c11' if inrange(dag, 18, 64) & !missing(state), fe vce(cluster pid)
di as result "IWP vs. AxI within person: " %6.2f (100 * _b[1.state]) " pp, " %6.1f (100 * 100 * _b[1.state] / `base_c') " % relative to AxI level"
* IWP Employee vs. not poor
lincom 100 * _b[1.state] - 100 * _b[3.state]

*** C4: Item decomposition - linear FE per SMSD item (M1, M11, M12), relative change vs. the item level of AxI
local items13 "dep_unexpected dep_holiday dep_arrears dep_meal dep_warm dep_car dep_furniture dep_clothes dep_shoes dep_social dep_leisure dep_pocket dep_internet"
foreach m in 1 11 12 {
    di _n as result "--- C4 items, M`m' ---"
    foreach y of local items13 {
        quietly sum `y' if smd_grp == 0
        local base_y = 100 * r(mean)
        quietly xtreg `y' i.smd_grp `c`m'' if !missing(smd_grp), fe vce(cluster pid)
        local b = _b[1.smd_grp]
        local se = _se[1.smd_grp]
        local p = 2 * ttail(e(df_r), abs(`b' / `se'))
        di as text %-16s "`y'" " M`m': " %6.2f (100 * `b') " pp (SE " %4.2f (100 * `se') "), " %6.1f (100 * 100 * `b' / `base_y') " %, p = " %6.4f `p'
        post `pc' ("C4") ("`y'") ("M`m'") (e(N)) (e(N_g)) (`b') (`se') (`p') (100 * `b') (100 * 100 * `b' / `base_y')
    }
}
postclose `pc'

* Results of C1, C2, C4 with Holm adjustment across the 13 items within each item model
preserve
use `res_c', clear
gen double p_holm = .
foreach m in M1 M11 M12 {
    tempvar r
    gen `r' = .
    quietly count if part == "C4" & model == "`m'"
    local k = r(N)
    sort part model p
    by part model: replace `r' = _n if part == "C4" & model == "`m'"
    replace p_holm = (`k' - `r' + 1) * p if part == "C4" & model == "`m'"
    by part model: replace p_holm = max(p_holm, p_holm[_n - 1]) if part == "C4" & model == "`m'" & _n > 1
    replace p_holm = min(p_holm, 1) if part == "C4" & model == "`m'"
    drop `r'
}
gen int model_n = real(subinstr(model, "M", "", .))
sort part model_n outcome
list part outcome model n n_pers pp rel p p_holm, noobs abbreviate(10) sepby(part model)
export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/L03_Panel_Results.xlsx", sheet("C_fixed_effects", replace) firstrow(variables)
restore


*******************************************************************************************************************************************************************************************
*** PART D: Descriptive dynamics - how many are persistently income-poor / deprived?
*** Each release contributes persons observed in all years of its last w years (release-w+1 ... release), weight RB06w
*** Group (IWP Employee / AROP w/o IWP / not poor) = state in the last year of the window, age 18-64
*** Persistent (Eurostat logic): poor / deprived in the last year and in >= 2 of 3 (w = 4) or >= 1 of 2 (w = 3) preceding years
*** Income poverty is available 2018-2024 -> 4-year windows from release 2021; SMSD only from 2018 with gaps -> 3-year windows
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART D: Descriptive dynamics ==================="

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear
tempfile prepared
save `prepared'

*** D1 / D2: income poverty (post-transfer) and group stability, 4- and 3-year windows
foreach w in 4 3 {
    use `prepared', clear
    di _n(2) as result "--- D1/D2: income poverty, `w'-year window (weight RB06`w') ---"
    gen byte in_win = inrange(year, release - `w' + 1, release)
    bysort release pid: egen n_obs = total(in_win & !missing(arop_post_rel))
    bysort release pid: egen pov_years = total(in_win & arop_post_rel == 1)
    bysort release pid: egen iwp_years = total(in_win & state == 1)
    bysort release pid: egen axi_years = total(in_win & state == 2)
    keep if year == release & RB06`w' > 0 & !missing(RB06`w') & n_obs == `w' & inrange(dag, 18, 64) & inlist(state, 1, 2, 3)
    count
    if r(N) == 0 {
        di as error "No persons with `w' years of income data - window skipped"
        continue
    }
    tab release
    gen byte pov_prev = pov_years - arop_post_rel
    if `w' == 4 gen byte persistent_arop = (arop_post_rel == 1 & pov_prev >= 2)
    if `w' == 3 gen byte persistent_arop = (arop_post_rel == 1 & pov_prev >= 1)
    gen byte ever_poor = (pov_years > 0)
    gen byte always_poor = (pov_years == `w')

    * Number of years poor (row %), by group in the last year and for all 18-64
    di _n as result "Years income-poor in the last `w' years (row %), by group in the last year"
    tab state pov_years [aw=RB06`w'], row nofreq
    tab pov_years [aw=RB06`w']
    tab state pov_years
    * Persistent / ever / always poor by group; persistent poverty among all 18-64
    table state [aw=RB06`w'], statistic(mean persistent_arop ever_poor always_poor) statistic(frequency) nformat(%9.4f mean)
    * Share of the currently poor who were poor before (persistence among the poor)
    table state if arop_post_rel == 1 [aw=RB06`w'], statistic(mean persistent_arop) nformat(%9.4f mean)

    * D2: group stability - years in the same group, among IWP Employees and AROP w/o IWP in the last year
    di _n as result "Years as IWP Employee (IWP in the last year) and years as AROP w/o IWP (AxI in the last year), row %"
    tab iwp_years [aw=RB06`w'] if state == 1
    tab axi_years [aw=RB06`w'] if state == 2
    * Where were they in the first year of the window?
    di _n as result "State in the first year of the window, by state in the last year (row %)"
    preserve
    use `prepared', clear
    keep if year == release - `w' + 1
    keep release pid state
    rename state state_first
    tempfile first
    save `first'
    restore
    merge 1:1 release pid using `first', keep(master match) nogenerate
    tab state state_first [aw=RB06`w'] if inlist(state, 1, 2), row nofreq
    tab state state_first if inlist(state, 1, 2)

    * IWP vs. AxI: persistent poverty, pp difference and relative change
    capture drop g
    gen byte g = (state == 1) if inlist(state, 1, 2)
    capture noisily logit persistent_arop i.g i.release [pw=RB06`w'] if arop_post_rel == 1, vce(cluster pid)
    if _rc == 0 {
        margins g, post
        lincom 100 * _b[1.g] - 100 * _b[0bn.g]
        nlcom (rel_change_pct: 100 * (_b[1.g] / _b[0bn.g] - 1))
    }
}

*** D3: SMSD over 3 years (RB063) - SMSD from 2018, personal items partly missing 2018-2020
use `prepared', clear
di _n(2) as result "--- D3: SMSD, 3-year window (weight RB063) ---"
gen byte in_win = inrange(year, release - 2, release)
bysort release pid: egen n_smd = total(in_win & !missing(smd))
bysort release pid: egen smd_years = total(in_win & smd == 1)
bysort release pid: egen pov_years = total(in_win & arop_post_rel == 1)
keep if year == release & RB063 > 0 & !missing(RB063) & n_smd == 3 & inrange(dag, 18, 64) & inlist(state, 1, 2, 3)
count
tab release
gen byte smd_prev = smd_years - smd
gen byte persistent_smd = (smd == 1 & smd_prev >= 1)
gen byte ever_smd = (smd_years > 0)
gen byte always_smd = (smd_years == 3)
gen byte always_poor = (pov_years == 3)

* Number of years in SMSD (row %), by group in the last year
tab state smd_years [aw=RB063], row nofreq
tab state smd_years
* Current, ever, persistent, always SMSD by group
table state [aw=RB063], statistic(mean smd ever_smd persistent_smd always_smd) statistic(frequency) nformat(%9.4f mean)
* Among the currently deprived: share already deprived in at least one of the two preceding years
table state if smd == 1 [aw=RB063], statistic(mean persistent_smd) statistic(frequency) nformat(%9.4f mean)
* Among the persistently income-poor (poor in all 3 years): SMSD over the window
table state if always_poor == 1 [aw=RB063], statistic(mean smd ever_smd persistent_smd) statistic(frequency) nformat(%9.4f mean)

* IWP vs. AxI: ever and persistent SMSD, pp difference and relative change
capture drop g
gen byte g = (state == 1) if inlist(state, 1, 2)
foreach y in ever_smd persistent_smd {
    di _n as result "--- IWP vs. AxI: `y' ---"
    capture noisily logit `y' i.g i.release [pw=RB063], vce(cluster pid)
    if _rc == 0 {
        margins g, post
        lincom 100 * _b[1.g] - 100 * _b[0bn.g]
        nlcom (rel_change_pct: 100 * (_b[1.g] / _b[0bn.g] - 1))
    }
}

di as result "=== FERTIG ==="

log close
