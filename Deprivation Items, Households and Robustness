********************************************************************************
* Control specifications: one model per control variable, then all together
* Every model contains year fixed effects
* M1:  year FE only
* M2:  + age group            M3:  + sex
* M4:  + household type       M5:  + income position (% of threshold) -> "beyond income"
* M6:  + education (ISCED)    M7:  + region (NUTS 1)       M8: + degree of urbanisation
* M9:  + general health (bad / very bad)                   M10: + limitation in activities
* M11: all controls together
* Missing values of education, urbanisation and health are an own category (constant N across models)
********************************************************************************

local c1 "i.year"
local c2 "i.year i.age_grp"
local c3 "i.year i.sex"
local c4 "i.year i.hh_type"
local c5 "i.year c.inc_rel"
local c6 "i.year i.educ3"
local c7 "i.year i.region"
local c8 "i.year i.urban"
local c9 "i.year i.health_bad"
local c10 "i.year i.limit"
local c11 "i.year i.age_grp i.sex i.hh_type c.inc_rel i.educ3 i.region i.urban i.health_bad i.limit"

********************************************************************************
* Helper program: group effect of a binary group variable on a binary outcome
* Returns OR (95% CI, p), average predicted shares per group, pp difference and relative change (with SE)
********************************************************************************

capture program drop grp_effect
program define grp_effect, rclass
    syntax varname, SAMPle(varname) GRoup(varname) [CONTRols(string)]
    quietly svy, subpop(`sample'): logit `varlist' i.`group' `controls'
    local b = _b[1.`group']
    local se = _se[1.`group']
    local df = e(df_r)
    local n = e(N_sub)
    local crit = invttail(`df', 0.025)
    local or = exp(`b')
    local or_lo = exp(`b' - `crit' * `se')
    local or_hi = exp(`b' + `crit' * `se')
    local p = 2 * ttail(`df', abs(`b' / `se'))
    quietly margins `group', subpop(`sample') vce(unconditional) post
    local s1 = 100 * _b[1.`group']
    local s0 = 100 * _b[0bn.`group']
    quietly lincom 100 * _b[1.`group'] - 100 * _b[0bn.`group']
    local pp = r(estimate)
    local pp_se = r(se)
    quietly nlcom (rel: 100 * (_b[1.`group'] / _b[0bn.`group'] - 1))
    tempname rb rV
    matrix `rb' = r(b)
    matrix `rV' = r(V)
    local rel = `rb'[1, 1]
    local rel_se = sqrt(`rV'[1, 1])
    di as text %-16s "`varlist'" " OR " %6.3f `or' " [" %5.3f `or_lo' "; " %5.3f `or_hi' "] p=" %6.4f `p' " | IWP " %6.2f `s1' "% AxI " %6.2f `s0' "% | " %7.2f `pp' " pp (SE " %4.2f `pp_se' ") | " %7.1f `rel' " % (SE " %4.1f `rel_se' ") | N=" `n'
    return scalar n = `n'
    return scalar or = `or'
    return scalar or_lo = `or_lo'
    return scalar or_hi = `or_hi'
    return scalar p = `p'
    return scalar s_iwp = `s1'
    return scalar s_axi = `s0'
    return scalar pp = `pp'
    return scalar pp_se = `pp_se'
    return scalar rel = `rel'
    return scalar rel_se = `rel_se'
end

* Results file for group effects (PART C, E)
tempname ph
tempfile res_effects
postfile `ph' str12 part str16 outcome str80 spec double(n or or_lo or_hi p s_iwp s_axi pp pp_se rel rel_se) using `res_effects', replace


*******************************************************************************************************************************************************************************************
*** PART B: Descriptives - item prevalence by group (pooled 2018-2024, weighted)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART B: Item prevalence by group ==================="

tempname pd
tempfile res_desc
postfile `pd' str16 outcome double(n_iwp n_axi s_iwp s_axi pp rel ratio_axi_iwp) using `res_desc', replace

foreach y of local outcomes {
    quietly count if s_main == 1 & smd_grp == 1 & !missing(`y')
    local n1 = r(N)
    quietly count if s_main == 1 & smd_grp == 0 & !missing(`y')
    local n0 = r(N)
    quietly sum `y' [aw=dwt] if s_main == 1 & smd_grp == 1
    local a = 100 * r(mean)
    quietly sum `y' [aw=dwt] if s_main == 1 & smd_grp == 0
    local b = 100 * r(mean)
    post `pd' ("`y'") (`n1') (`n0') (`a') (`b') (`a' - `b') (100 * (`a' / `b' - 1)) (`b' / `a')
    di as text %-16s "`y'" " IWP " %6.2f `a' "%  AxI " %6.2f `b' "%  diff " %7.2f (`a' - `b') " pp  rel " %7.1f (100 * (`a' / `b' - 1)) " %  ratio AxI/IWP " %5.2f (`b' / `a')
}
postclose `pd'

*** Mean number of lacking items
table smd_grp if s_main == 1 [aw=dwt], statistic(mean dep_count) statistic(p50 dep_count) nformat(%9.2f mean p50)

*** Item prevalence by year and group
foreach y of local outcomes {
    di _n as result "--- `y' by year ---"
    table year smd_grp if s_main == 1 [pw=dwt], statistic(mean `y') nformat(%9.4f mean)
}


*******************************************************************************************************************************************************************************************
*** PART C: Headline SMD effect - one control at a time and all together (pooled 2018-2024)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART C: Headline SMD effect, M1-M11 ==================="

forvalues m = 1/11 {
    di _n as result "--- M`m': `c`m'' ---"
    grp_effect smd, sample(s_main) group(smd_grp) controls(`c`m'')
    post `ph' ("C_headline") ("smd") ("M`m'") (r(n)) (r(or)) (r(or_lo)) (r(or_hi)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
}

*** Full model with all controls (M11): coefficients of all controls
svy, subpop(s_main): logit smd i.smd_grp `c11', or


*******************************************************************************************************************************************************************************************
*** PART D: Time pattern - SMD by year and group (M1, no further controls)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART D: SMD by year and group ==================="

svy, subpop(s_main): logit smd i.smd_grp##i.year
* Predicted SMD shares by year and group
margins year#smd_grp, subpop(s_main) vce(unconditional)
* Difference IWP Employees minus AROP w/o IWP by year (x100 = pp)
margins year, dydx(smd_grp) subpop(s_main) vce(unconditional)
* Does the gap change over time? (joint test of interaction terms)
svy, subpop(s_main): logit smd i.smd_grp##i.year
testparm i.smd_grp#i.year


*******************************************************************************************************************************************************************************************
*** PART E: Item decomposition - employment effect on each item (M1-M11, one table per model)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART E: Item decomposition ==================="

forvalues m = 1/11 {
    di _n as result "--- Items, M`m': `c`m'' ---"
    foreach y in `items13' `items_arr' {
        grp_effect `y', sample(s_main) group(smd_grp) controls(`c`m'')
        post `ph' ("E_items") ("`y'") ("M`m'") (r(n)) (r(or)) (r(or_lo)) (r(or_hi)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    }
}

postclose `ph'


*******************************************************************************************************************************************************************************************
*** PART F: Heterogeneity - does the employment effect differ by household type / children?
*** Interaction models on M4 controls; joint Wald test of the interaction terms
***   F1: smd_grp x hh_type (9 household types)
***   F2: smd_grp x has_kids (0 vs. 1+ children; robust to small cells)
***   F3: smd_grp x n_ch_cat (0/1/2/3+ children)
*** p-values Holm- and Bonferroni-adjusted across the 13 items (index tested separately)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART F: Heterogeneity ==================="

tempname pg
tempfile res_het
postfile `pg' str16 outcome double(p_hhtype p_haskids p_nchcat) using `res_het', replace

foreach y in smd `items13' {

    di _n as result "--- `y' ---"

    quietly svy, subpop(s_main): logit `y' i.smd_grp##i.hh_type i.year i.age_grp i.sex c.inc_rel
    quietly testparm i.smd_grp#i.hh_type
    local p1 = r(p)

    quietly svy, subpop(s_main): logit `y' i.smd_grp##i.has_kids c.n_adults i.year i.age_grp i.sex c.inc_rel
    quietly testparm i.smd_grp#i.has_kids
    local p2 = r(p)

    quietly svy, subpop(s_main): logit `y' i.smd_grp##i.n_ch_cat c.n_adults i.year i.age_grp i.sex c.inc_rel
    quietly testparm i.smd_grp#i.n_ch_cat
    local p3 = r(p)

    di as text %-16s "`y'" " p(group x hh_type) = " %6.4f `p1' "   p(group x has_kids) = " %6.4f `p2' "   p(group x n_children) = " %6.4f `p3'
    post `pg' ("`y'") (`p1') (`p2') (`p3')

    * Effect of employment by subgroup (x100 = pp, with 95% CI)
    * Shown for the index (to quantify a null result: how large a difference can the CIs exclude?),
    * for the food item (SA2 finding) and for every item with unadjusted p < 0.05 in the respective test
    if "`y'" == "smd" | "`y'" == "dep_meal" | `p1' < 0.05 {
        quietly svy, subpop(s_main): logit `y' i.smd_grp##i.hh_type i.year i.age_grp i.sex c.inc_rel
        di _n as text "Employment effect by household type (dydx x100 = pp):"
        margins hh_type, dydx(smd_grp) subpop(s_main) vce(unconditional)
        di _n as text "Odds ratios by household type:"
        forvalues h = 1/9 {
            capture lincom _b[1.smd_grp] + _b[1.smd_grp#`h'.hh_type], or
        }
    }
    if "`y'" == "smd" | "`y'" == "dep_meal" | `p2' < 0.05 {
        quietly svy, subpop(s_main): logit `y' i.smd_grp##i.has_kids c.n_adults i.year i.age_grp i.sex c.inc_rel
        di _n as text "Employment effect without / with children (dydx x100 = pp):"
        margins has_kids, dydx(smd_grp) subpop(s_main) vce(unconditional)
    }
    if "`y'" == "smd" | "`y'" == "dep_meal" | `p3' < 0.05 {
        quietly svy, subpop(s_main): logit `y' i.smd_grp##i.n_ch_cat c.n_adults i.year i.age_grp i.sex c.inc_rel
        di _n as text "Employment effect by number of children (dydx x100 = pp):"
        margins n_ch_cat, dydx(smd_grp) subpop(s_main) vce(unconditional)
    }
}
postclose `pg'

*** Cell sizes household type x group (check before interpreting)
tab hh_type smd_grp if s_main == 1


*******************************************************************************************************************************************************************************************
*** PART G: Household structure and poverty risk - children vs. adults
*** Outcomes: poverty pre and post within each group's base population (2018-2024, age 18-64)
***   IWP Employees: base = employees >= 7 months (employed == 1); outcome iw_arop_pre_rel / iw_poor_post_rel
***   AROP w/o IWP: base = not working >= 7 months in any status, 18-64; outcome axi_pre_rel / axi_post_rel
*** Models: M1 children, M2 adults, M3 both, M4 both standardised; all with year FE
*** Wald test children = adults in M3 and M4 (needed before claiming that one predictor dominates)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART G: Children vs. adults ==================="

capture drop base_iwp base_axi z_children z_adults
gen byte base_iwp = (employed == 1 & inrange(year, 2018, 2024))
gen byte base_axi = (any_worker == 0 & inrange(dag, 18, 64) & inrange(year, 2018, 2024))

egen z_children = std(n_children) if inrange(dag, 18, 64) & inrange(year, 2018, 2024)
egen z_adults = std(n_adults) if inrange(dag, 18, 64) & inrange(year, 2018, 2024)
label variable z_children "Number of children (standardised, 18-64, 2018-2024)"
label variable z_adults "Number of persons 14+ (standardised, 18-64, 2018-2024)"

tempname phh
tempfile res_hh
postfile `phh' str16 outcome str4 model str12 predictor double(n or or_lo or_hi p) using `res_hh', replace

foreach y in iw_arop_pre_rel iw_poor_post_rel axi_pre_rel axi_post_rel {

    if inlist("`y'", "iw_arop_pre_rel", "iw_poor_post_rel") local base "base_iwp"
    else local base "base_axi"

    di _n as result "--- `y' (base: `base') ---"

    local p1 "c.n_children"
    local p2 "c.n_adults"
    local p3 "c.n_children c.n_adults"
    local p4 "c.z_children c.z_adults"

    forvalues m = 1/4 {
        svy, subpop(`base'): logit `y' `p`m'' i.year, or
        local df = e(df_r)
        local n = e(N_sub)
        local crit = invttail(`df', 0.025)
        foreach x in n_children n_adults z_children z_adults {
            capture local b = _b[`x']
            if _rc == 0 {
                local se = _se[`x']
                post `phh' ("`y'") ("M`m'") ("`x'") (`n') (exp(`b')) (exp(`b' - `crit' * `se')) (exp(`b' + `crit' * `se')) (2 * ttail(`df', abs(`b' / `se')))
            }
        }
        * Test: is the children effect equal to the adults effect? (M3 per person, M4 per SD)
        if `m' == 3 {
            test n_children = n_adults
            post `phh' ("`y'") ("M3") ("test ch=ad") (`n') (.) (.) (.) (r(p))
        }
        if `m' == 4 {
            test z_children = z_adults
            post `phh' ("`y'") ("M4") ("test ch=ad") (`n') (.) (.) (.) (r(p))
        }
        * AMEs (x100 = pp) for the joint unstandardised model
        if `m' == 3 {
            margins, dydx(n_children n_adults) subpop(`base') vce(unconditional)
        }
    }
}
postclose `phh'


*******************************************************************************************************************************************************************************************
*** PART H: Sector within IWP Employees (who are the working poor, and where are they deprived?)
*** Sector exists only for persons with a job -> analysed within IWP Employees / employees only
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART H: Sector within IWP Employees ==================="

capture drop s_emp s_iwp
gen byte s_emp = (employed == 1 & !missing(iw_poor_post_rel) & inrange(year, 2018, 2024))
gen byte s_iwp = (s_main == 1 & smd_grp == 1)

