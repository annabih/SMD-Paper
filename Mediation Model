postclose med_paths
postclose med_lad
postclose med_dec

use `f_paths', clear
format a a_se b b_se ab %9.4f
list, noobs abbreviate(10) separator(0)
export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/05_Deprivation_Results.xlsx", sheet("Med_paths", replace) firstrow(variables)

use `f_lad', clear
format s_nep s_iwp pp pp_se %6.2f
format rel rel_se %6.1f
list, noobs abbreviate(10) separator(0)
export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/05_Deprivation_Results.xlsx", sheet("Med_ladder", replace) firstrow(variables)

use `f_dec', clear
format logit %7.3f
format share share_lo share_hi rel %6.1f
format pp pp_se pp_lo pp_hi %6.2f
list, noobs abbreviate(10) separator(0)
export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/05_Deprivation_Results.xlsx", sheet("Med_KHB", replace) firstrow(variables)

