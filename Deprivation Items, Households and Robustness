* C, E: group effects; Holm and Bonferroni across the 13 items within each item specification
use `res_effects', clear
gen byte main13 = (part == "E_items" & !inlist(outcome, "dep_arr_rent", "dep_arr_util", "dep_arr_loan"))
gen double p_bonf = .
gen double p_holm = .
forvalues mm = 1/11 {
    local m "M`mm'"
    preserve
    keep if main13 == 1 & spec == "`m'"
    local k = _N
    sort p
    gen double holm = (`k' - _n + 1) * p
    replace holm = max(holm, holm[_n - 1]) if _n > 1
    replace holm = min(holm, 1)
    gen double bonf = min(`k' * p, 1)
    keep outcome spec holm bonf
    tempfile adj_`m'
    save `adj_`m''
    restore
    merge 1:1 outcome spec using `adj_`m'', nogenerate update
    replace p_holm = holm if !missing(holm)
    replace p_bonf = bonf if !missing(bonf)
    drop holm bonf
}
order part outcome spec n or or_lo or_hi p p_holm p_bonf s_iwp s_axi pp pp_se rel rel_se
list part outcome spec or p p_holm s_iwp s_axi pp rel, noobs abbreviate(8) separator(0)

* Full item tables per model (input for the LaTeX tables)
gen int spec_n = real(subinstr(spec, "M", "", .))
sort spec_n outcome
forvalues mm = 1/11 {
    di _n as result "--- Item table M`mm' ---"
    list outcome n s_iwp s_axi pp pp_se rel rel_se or p p_holm if part == "E_items" & spec_n == `mm', noobs abbreviate(10) separator(0) clean
}
drop spec_n
export excel using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/05_Deprivation_Results.xlsx", sheet("CE_effects", replace) firstrow(variables)

* F: heterogeneity tests; Holm and Bonferroni across the 13 items (index excluded)
use `res_het', clear
foreach t in hhtype haskids nchcat {
    gen double p_`t'_bonf = .
    gen double p_`t'_holm = .
    * index (smd) sorted last, items by p-value
    gen byte is_index = (outcome == "smd")
    sort is_index p_`t'
    quietly count if outcome != "smd"
    local k = r(N)
    gen long r_`t' = sum(outcome != "smd") if outcome != "smd"
    replace p_`t'_bonf = min(`k' * p_`t', 1) if outcome != "smd"
    replace p_`t'_holm = (`k' - r_`t' + 1) * p_`t' if outcome != "smd"
    replace p_`t'_holm = max(p_`t'_holm, p_`t'_holm[_n - 1]) if outcome != "smd" & r_`t' > 1
    replace p_`t'_holm = min(p_`t'_holm, 1) if outcome != "smd"
    drop r_`t' is_index
}
