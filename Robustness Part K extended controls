*** K0: destring numeric variables (decimal comma); create empty variable if not in the dataset
local knum "PL016 PH020 PH030 PH040 PH060 PY021N PY130N PY120G PW010 PW191 PT220 PT230 PT240 PT210 PT190 PHD01 PHD06 PL025 PL020"
foreach v of local knum {
    capture confirm variable `v'
    if _rc != 0 {
        di as error "`v' not in the dataset (check merge script / UDB release)"
        gen double `v' = .
    }
    capture confirm string variable `v'
    if _rc == 0 {
        replace `v' = subinstr(`v', ",", ".", .)
        destring `v', replace force
    }
}
* Parents' country of birth: string codes LOC / EU / OTH
foreach v in PB230 PB240 {
    capture confirm variable `v'
    if _rc != 0 {
        di as error "`v' not in the dataset (check merge script / UDB release)"
        gen str3 `v' = ""
    }
    capture confirm string variable `v'
    if _rc != 0 {
        tostring `v', replace force
        replace `v' = "" if `v' == "."
    }
    replace `v' = strtrim(`v')
}

*** K1: availability by survey year (share of the SMD comparison groups with a valid value)
foreach v of local knum {
    capture drop av_`v'
    gen byte av_`v' = !missing(`v')
}
foreach v in PB230 PB240 {
    capture drop av_`v'
    gen byte av_`v' = (`v' != "")
}
di _n as result "--- K1: share with valid values by year (IWP + NEP) ---"
tabstat av_* if s_main == 1, by(year) statistics(mean) columns(variables) format(%4.2f)
di _n as result "--- K1: share with valid values by group (pooled) ---"
tabstat av_* if s_main == 1, by(smd_grp) statistics(mean) columns(variables) format(%4.2f)

*** K2: constructed variables (missing = own category 9 / 99 so that N stays constant within the available years)
capture drop k_*
gen byte k_migback = 9
replace k_migback = 0 if PB230 == "LOC" & PB240 == "LOC"
replace k_migback = 1 if inlist(PB230, "EU", "OTH") | inlist(PB240, "EU", "OTH")
label define kmig 0 "Both parents born in AT" 1 "At least one parent born abroad" 9 "Missing", replace
label values k_migback kmig
gen byte k_chronic = 9
replace k_chronic = 1 if PH020 == 1
replace k_chronic = 0 if PH020 == 2
gen byte k_disben = (PY130N > 0 & !missing(PY130N))
gen byte k_sickben = (PY120G > 0 & !missing(PY120G))
gen byte k_compcar = (PY021N > 0 & !missing(PY021N))
foreach v in PT220 PT230 PT240 PT210 PT190 PHD01 PHD06 {
    gen int k_`v' = `v'
    replace k_`v' = 99 if missing(k_`v')
}
gen double k_lifesat = PW010
gen double k_trust = PW191
* Additional outcomes (binary)
gen byte o_unmet_med = (PH040 == 1) if inlist(PH040, 1, 2)
gen byte o_unmet_dent = (PH060 == 1) if inlist(PH060, 1, 2)
gen byte o_lowsat = (PW010 <= 5) if !missing(PW010)
gen byte o_lowtrust = (PW191 <= 4) if !missing(PW191)
label variable o_lowsat "Life satisfaction 0-5"
label variable o_lowtrust "Trust in others 0-4"

*** Year sample per variable: survey years in which > 50 % of the comparison groups have a valid value
capture program drop k_years
program define k_years
    args avvar newvar
    tempvar sh
    egen `sh' = mean(cond(s_main == 1, `avvar', .)), by(year)
    gen byte `newvar' = (s_main == 1 & `sh' > 0.5 & !missing(`sh'))
end

*** K3: baseline ladder M1-M12 (all years) and each new control as an additional single-control model
di _n as result "--- K3a: baseline M1-M12 (all years) ---"
forvalues m = 1/12 {
    grp_effect smd, sample(s_main) group(smd_grp) controls(`c`m'')
    post `pk' ("base") ("smd") ("M`m'") ("2018-2024") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
}

* New controls: name of the control term and the availability variable it depends on
local newctrl "migback chronic disben sickben compcar PT220 PT230 PT240 PT210 PT190 PHD01 PHD06 lifesat trust"
foreach x of local newctrl {
    local term "i.k_`x'"
    local av "av_PB230"
    if "`x'" == "chronic" local av "av_PH020"
    if "`x'" == "disben" local av "av_PY130N"
    if "`x'" == "sickben" local av "av_PY120G"
    if "`x'" == "compcar" local av "av_PY021N"
    if inlist("`x'", "PT220", "PT230", "PT240", "PT210", "PT190", "PHD01", "PHD06") local av "av_`x'"
    if "`x'" == "lifesat" {
        local term "c.k_lifesat"
        local av "av_PW010"
    }
    if "`x'" == "trust" {
        local term "c.k_trust"
        local av "av_PW191"
    }
    capture drop s_k
    k_years `av' s_k
    if inlist("`x'", "lifesat", "trust") replace s_k = 0 if missing(k_`x')
    quietly count if s_k == 1
    if r(N) < 200 {
        di as error "`x': not enough observations in the available years (N = " r(N) ") - skipped"
        continue
    }
    quietly levelsof year if s_k == 1, local(yrs)
    local yrs = subinstr(trim("`yrs'"), " ", ",", .)
    di _n as result "--- K3b: `x' (years `yrs') ---"
    * Same sample: M1, M1 + X, M12, M12 + X
    grp_effect smd, sample(s_k) group(smd_grp) controls(`c1')
    post `pk' ("single") ("`x'") ("M1") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    grp_effect smd, sample(s_k) group(smd_grp) controls(`c1' `term')
    post `pk' ("single") ("`x'") ("M1+X") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    grp_effect smd, sample(s_k) group(smd_grp) controls(`c12')
    post `pk' ("single") ("`x'") ("M12") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    grp_effect smd, sample(s_k) group(smd_grp) controls(`c12' `term')
    post `pk' ("single") ("`x'") ("M12+X") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
}

*** K4: combined model - M12 + all new controls available in the same years (migration background, chronic illness, disability and sickness benefits)
capture drop s_k
k_years av_PB230 s_k
replace s_k = 0 if s_k == 1 & missing(PH020) & missing(PY130N)
quietly levelsof year if s_k == 1, local(yrs)
local yrs = subinstr(trim("`yrs'"), " ", ",", .)
di _n as result "--- K4: combined model (years `yrs') ---"
foreach m in 12 11 {
    grp_effect smd, sample(s_k) group(smd_grp) controls(`c`m'')
    post `pk' ("comb") ("smd") ("M`m'") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    grp_effect smd, sample(s_k) group(smd_grp) controls(`c`m'' i.k_migback i.k_chronic i.k_disben i.k_sickben)
    post `pk' ("comb") ("smd") ("M`m'+all") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
}

*** K5: additional indicators as outcomes (unmet medical / dental needs, low life satisfaction, low trust)
foreach y in o_unmet_med o_unmet_dent o_lowsat o_lowtrust {
    capture drop s_k
    gen byte s_k = (s_main == 1 & !missing(`y'))
    quietly count if s_k == 1 & smd_grp == 1
    if r(N) < 100 {
        di as error "`y': too few observations - skipped"
        continue
    }
    quietly levelsof year if s_k == 1, local(yrs)
    local yrs = subinstr(trim("`yrs'"), " ", ",", .)
    di _n as result "--- K5: outcome `y' (years `yrs') ---"
    foreach m in 1 5 12 {
        grp_effect `y', sample(s_k) group(smd_grp) controls(`c`m'')
        post `pk' ("outcome") ("`y'") ("M`m'") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    }
}
di _n as result "--- K5: mean life satisfaction and trust by group (weighted) ---"
table smd_grp if s_main == 1 [aw=dwt], statistic(mean PW010 PW191) statistic(count PW010 PW191) nformat(%9.2f mean)

*** K6: variables that only exist for one group (cannot be controls): descriptives and NEP subgroups
* PL016, PL020, PL025 are only asked of persons not currently employed; the company car only exists with employee income
di _n as result "--- K6: company car by group ---"
table smd_grp if s_main == 1 [aw=dwt], statistic(mean k_compcar) nformat(%9.3f mean)
foreach v in PL016 PL020 PL025 {
    di _n as result "--- K6: `v' among NEP (weighted column %) and SMSD by category ---"
    capture noisily tab year `v' if s_main == 1 & smd_grp == 0, missing
    capture noisily table `v' if s_main == 1 & smd_grp == 0 [aw=dwt], statistic(mean smd) statistic(frequency) nformat(%9.3f mean)
}
* IWP vs. NEP who have previous employment experience other than occasional work (PL016 == 3)
capture drop s_k
gen byte s_k = (s_main == 1 & (smd_grp == 1 | (smd_grp == 0 & PL016 == 3)))
quietly count if s_k == 1 & smd_grp == 0
if r(N) >= 100 {
    quietly levelsof year if s_k == 1 & smd_grp == 0, local(yrs)
    local yrs = subinstr(trim("`yrs'"), " ", ",", .)
    di _n as result "--- K6: IWP vs. NEP with previous employment experience (years `yrs') ---"
    replace s_k = 0 if !inlist(year, `yrs')
    foreach m in 1 12 {
        grp_effect smd, sample(s_k) group(smd_grp) controls(`c`m'')
        post `pk' ("subgrp") ("NEP_PL016_3") ("M`m'") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    }
}
* IWP vs. NEP who are available for work (PL025 == 1) or actively looking (PL020 == 1)
foreach v in PL025 PL020 {
    capture drop s_k
    gen byte s_k = (s_main == 1 & (smd_grp == 1 | (smd_grp == 0 & `v' == 1)))
    quietly count if s_k == 1 & smd_grp == 0
    if r(N) < 100 continue
    quietly levelsof year if s_k == 1 & smd_grp == 0, local(yrs)
    local yrs = subinstr(trim("`yrs'"), " ", ",", .)
    replace s_k = 0 if !inlist(year, `yrs')
    di _n as result "--- K6: IWP vs. NEP with `v' == 1 (years `yrs') ---"
    foreach m in 1 12 {
        grp_effect smd, sample(s_k) group(smd_grp) controls(`c`m'')
        post `pk' ("subgrp") ("NEP_`v'_1") ("M`m'") ("`yrs'") (r(n)) (r(or)) (r(p)) (r(s_iwp)) (r(s_axi)) (r(pp)) (r(pp_se)) (r(rel)) (r(rel_se))
    }
}
