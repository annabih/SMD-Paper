* Helper: expand factor-notation lists into 0/1 dummies (lowest category = reference, dropped)
capture program drop med_expand
program define med_expand, rclass
    syntax anything(name=vlist), prefix(name)
    local out ""
    foreach t of local vlist {
        if substr("`t'", 1, 2) == "i." {
            local v = substr("`t'", 3, .)
            capture drop `prefix'`v'_*
            quietly tab `v' if s_med == 1, gen(`prefix'`v'_)
            drop `prefix'`v'_1
            capture unab d : `prefix'`v'_*
            if _rc == 0 local out "`out' `d'"
        }
        else {
            local v = subinstr("`t'", "c.", "", 1)
            local out "`out' `v'"
        }
    }
    return local list "`out'"
end

