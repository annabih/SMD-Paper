*******************************************************************************************************************************************************************************************
*** Title: Panel descriptives - dynamics of income poverty (EU-SILC longitudinal, Austria)
*** Aim: Describe how persistent income poverty is among IWP Employees and AROP w/o IWP (no causal models)
***   SMSD is not analysed longitudinally: no persons with valid SMSD in all 4 years, and in 3-year windows only
***   77 IWP Employees who stay poor (post) -> SMSD only in the cross-section
***   PART A: Panel structure - person-years by year and group, years observed per person
***   PART B: Year-to-year transitions (each release's last year pair, two-year weight RB062)
***           B1 transition matrix between groups (post and pre), B1b by year pair
***   PART C: Following persons over the whole window (each release's last w years, persons observed in all w years)
***           Group = group in the FIRST year of the window (starting group), so durations are followed forward
***           C1 income poverty, 4 years (RB064) and 3 years (RB063): how many years poor among the ever-poor,
***              share still poor after 1, 2, 3 years (continuously) and in the last year, by starting group
***           C2 where the starting groups are in each following year, flows between years (alluvial) and complete paths
***           C1/C2 also with groups and poverty defined BEFORE social transfers (aroppre)
*** Groups (as in all cross-sectional analyses, age 18-64, post-transfer):
***   1 = IWP Employee, 2 = AROP w/o IWP (not working >= 7 months, without old-age benefits), 3 = not poor, 4 = other poor
*** Data notes:
***   - Income poverty: threshold from the cross-sectional pipeline, available 2018-2024 (no threshold before 2018)
***   - All shares weighted with the release-specific longitudinal weights; comparisons IWP vs. AxI in pp and %
*** Input: SILC_Long_Prepared.dta, SILC_Long_Panel.dta (L02)
*** Output: L03_Panel_Descriptives_log.txt
*******************************************************************************************************************************************************************************************

capture log close
clear all
set more off

log using "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/L03_Panel_Descriptives_log.txt", text replace


*******************************************************************************************************************************************************************************************
*** PART A: Panel structure
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART A: Panel structure ==================="

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Panel.dta", clear
keep if id_inconsistent == 0

*** Person-years by year and group (18-64)
tab year state if inrange(dag, 18, 64)

*** Years observed per person (18-64)
bysort pid: egen n_years = total(inrange(dag, 18, 64))
egen byte pid_tag = tag(pid)
tab n_years if pid_tag == 1 & n_years > 0

*** Persons ever IWP Employee, ever AROP w/o IWP, and both
bysort pid: egen ever_iwp = max(state == 1)
bysort pid: egen ever_axi = max(state == 2)
tab ever_iwp ever_axi if pid_tag == 1


*******************************************************************************************************************************************************************************************
*** PART B: Year-to-year transitions t-1 -> t
*** Each release contributes its last year pair (release - 1 -> release), weighted with its two-year weight RB062
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART B: Transitions ==================="

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear

bysort release pid (year): gen byte state_lag = state[_n - 1] if year[_n - 1] == year - 1
keep if year == release & RB062 > 0 & !missing(RB062) & !missing(state, state_lag)
tab release

*** B1: Transition matrix (row %: where do persons in group t-1 end up in t?) and cell sizes
tab state_lag state [aw=RB062], row nofreq
tab state_lag state

*** B1 pre: Transition matrix with groups defined BEFORE social transfers (same persons, same weight)
use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear
bysort release pid (year): gen byte state_pre_lag = state_pre[_n - 1] if year[_n - 1] == year - 1
keep if year == release & RB062 > 0 & !missing(RB062) & !missing(state_pre, state_pre_lag)
di _n as result "--- B1 pre: transition matrix, groups before social transfers (row %) ---"
tab state_pre_lag state_pre [aw=RB062], row nofreq
tab state_pre_lag state_pre

* back to the post-transfer transition file
use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear
bysort release pid (year): gen byte state_lag = state[_n - 1] if year[_n - 1] == year - 1
keep if year == release & RB062 > 0 & !missing(RB062) & !missing(state, state_lag)

*** B1b: Transition matrix separately for each year pair (release - 1 -> release), row % and cell sizes
forvalues r = 2019/2023 {
    local r0 = `r' - 1
    di _n as result "--- B1b: transitions `r0' -> `r' (release `r') ---"
    capture noisily tab state_lag state [aw=RB062] if release == `r', row nofreq
    capture noisily tab state_lag state if release == `r'
}

*******************************************************************************************************************************************************************************************
*** PART C: Following persons over the whole window
*** Each release contributes persons observed in all years of its last w years (release-w+1 ... release), weight RB06w
*** Starting group = group in the first year of the window (18-64); outcomes followed in years 2 ... w
*** Income poverty: 2018-2024 -> 4-year windows (releases 2021-2023) and 3-year windows (releases 2020-2023)
*******************************************************************************************************************************************************************************************

di _n(2) as result "=================== PART C: Following persons over the window ==================="

use "/Users/anna/Library/Mobile Documents/com~apple~CloudDocs/1. Oxford/EU-SILC/SILC_Long_Prepared.dta", clear
tempfile prepared
save `prepared'

foreach spec in "arop 4" "aroppre 4" "arop 3" "aroppre 3" {
    tokenize `spec'
    local o "`1'"
    local w = `2'
    * Outcome and group variable: post (default), pre = before social transfers
    local gv "state"
    if "`o'" == "arop" local ov "arop_post_rel"
    if "`o'" == "aroppre" {
        local ov "arop_pre_rel"
        local gv "state_pre"
    }

    use `prepared', clear
    di _n(2) as result "===== `o', `w'-year window (weight RB06`w') ====="

    * Outcome and group in each year k = 1 ... w of the window (k = 1: first year)
    forvalues k = 1/`w' {
        bysort release pid: egen y`k' = max(cond(year == release - `w' + `k', `ov', .))
        bysort release pid: egen g`k' = max(cond(year == release - `w' + `k', `gv', .))
    }
    * Explicit variable lists (y1-y`w' as a range would also include g1, g2, ... because of the variable order)
    local ylist ""
    local ylater ""
    local contlater ""
    forvalues k = 1/`w' {
        local ylist "`ylist' y`k'"
        if `k' > 1 local ylater "`ylater' y`k'"
        if `k' > 1 local contlater "`contlater' cont`k'"
    }
    egen n_valid = rownonmiss(`ylist')
    keep if year == release & RB06`w' > 0 & !missing(RB06`w') & n_valid == `w' & inlist(g1, 1, 2, 3, 4)
    count
    if r(N) == 0 {
        di as error "No persons with `w' valid years - skipped"
        continue
    }
    tab release
    label values g1 statelbl

    egen years = rowtotal(`ylist')
    gen byte ever = (years > 0)
    gen byte always = (years == `w')
    * Continuously in the outcome from year 1 (survival): still after 1, 2, 3 further years
    gen byte cont1 = (y1 == 1)
    forvalues k = 2/`w' {
        local km1 = `k' - 1
        gen byte cont`k' = (cont`km1' == 1 & y`k' == 1)
    }
    * Number of separate spells (entries) within the window
    gen byte spells = (y1 == 1)
    forvalues k = 2/`w' {
        local km1 = `k' - 1
        replace spells = spells + (y`k' == 1 & y`km1' == 0)
    }

    *** C1a: How many years in the outcome? All persons, and among those ever affected, by starting group
    di _n as result "--- `o': years in the outcome (row %), all persons, by starting group ---"
    tab g1 years [aw=RB06`w'], row nofreq
    tab g1 years
    di _n as result "--- `o': years in the outcome among the ever affected (row %), by starting group ---"
    tab g1 years [aw=RB06`w'] if ever == 1, row nofreq
    table g1 if ever == 1 [aw=RB06`w'], statistic(mean years always spells) statistic(frequency) nformat(%9.3f mean)
    di _n as result "--- `o': all persons 18-64, years in the outcome (%) ---"
    tab years [aw=RB06`w']

    *** C1b: Those affected in the first year: share still affected (continuously) and affected in each later year
    di _n as result "--- `o': affected in year 1 -> continuously affected up to year k, and affected in year k, by starting group ---"
    table g1 if y1 == 1 [aw=RB06`w'], statistic(mean `contlater') statistic(mean `ylater') statistic(frequency) nformat(%9.3f mean)

    *** C2: Where are the starting groups in each later year, and which paths do they take?
    if inlist("`o'", "arop", "aroppre") {
        forvalues k = 2/`w' {
            di _n as result "--- Group in year `k' by starting group (row %) ---"
            tab g1 g`k' [aw=RB06`w'] if inlist(g1, 1, 2), row nofreq
        }
        * Full transition matrix for every year step of the persons followed over the window (all starting groups)
        forvalues k = 1/`=`w'-1' {
            local kp1 = `k' + 1
            di _n as result "--- Transition matrix year `k' -> year `kp1' (persons followed `w' years, row %) ---"
            tab g`k' g`kp1' [aw=RB06`w'] if inlist(g`k', 1, 2, 3, 4) & inlist(g`kp1', 1, 2, 3, 4), row nofreq
            tab g`k' g`kp1' if inlist(g`k', 1, 2, 3, 4) & inlist(g`kp1', 1, 2, 3, 4)
        }
        * Flows between consecutive years within each starting group (cell %, input for an alluvial diagram)
        forvalues sg = 1/2 {
            forvalues k = 1/`=`w'-1' {
                local kp1 = `k' + 1
                di _n as result "--- Starting group `sg': flows year `k' -> year `kp1' (cell % of the starting group) ---"
                tab g`k' g`kp1' [aw=RB06`w'] if g1 == `sg', cell nofreq
            }
        }
        * Complete paths over the window (I = IWP Employee, A = AROP w/o IWP, N = not poor, O = other poor)
        gen str4 path = ""
        forvalues k = 1/`w' {
            replace path = path + cond(g`k' == 1, "I", cond(g`k' == 2, "A", cond(g`k' == 3, "N", "O")))
        }
        forvalues sg = 1/2 {
            di _n as result "--- Starting group `sg': most frequent paths (weighted %) ---"
            tab path [aw=RB06`w'] if g1 == `sg', sort
        }
    }
}

di as result "=== FERTIG ==="

log close
